# ============================================
# FlowOps — Variáveis de Ambiente (TEMPLATE)
# ============================================
# COMO USAR EM DEV LOCAL:
#   1. Copia este arquivo para  backend/.env
#   2. Preenche os valores reais (NUNCA commita o .env preenchido)
#
# EM PRODUÇÃO (Railway):
#   Não usa este arquivo — todas as vars são definidas no painel do
#   Railway: Settings → Variables.
# ============================================

# ---- Banco de dados ----
# Em DEV: Postgres local via docker-compose (docker compose up -d db)
# Em PROD: Railway injeta DATABASE_URL automaticamente quando o
# Postgres da Railway é vinculado ao serviço.
DATABASE_URL=postgresql://flowops:flowops@localhost:5432/flowops

# ---- Autenticação ----
# Gere uma string aleatória com 64+ chars (ex: openssl rand -hex 32)
JWT_SECRET=troque-este-valor-em-producao-use-64-chars-aleatorios
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=7d

# ============================================
# ⚰️ ERP legado e WordPress — NÃO CONFIGURE
# ============================================
# Encerrados em 27/08/2026: o WordPress/WooCommerce hospedado na KingHost
# foi APAGADO, e o MySQL do ERP Giga/Wincred (que ficava no host do
# fornecedor, não na KingHost) parou de aceitar o IP do Railway. Nenhum dos
# dois é alcançável. Não há ERP_HOST / ERP_USER / ERP_PASSWORD /
# ERP_DATABASE nem WP_DB_* / WC_* / FLOWOPS_WP_* pra preencher — as
# variáveis saíram daqui de propósito, pra ninguém perder tempo procurando
# credencial de servidor que não responde.
#
# A fonte da verdade de estoque, venda, catálogo, crediário, clientes e
# financeiro é o Postgres deste DATABASE_URL. As tabelas com prefixo
# wincred_* e giga_* são espelhos NATIVOS do próprio Flow: o nome é
# herança, elas não falam com ERP nenhum.
#
# As travas vivem em backend/src/common/replica-giga.ts. Não religar.
#
# 🚨 ATENÇÃO — ISTO **NÃO** VALE PRA TODA ENV COM "ERP" NO NOME.
# As que governam a baixa de estoque NO POSTGRES ficam LIGADAS e não são
# deste bloco. O "ERP" no nome delas é herança, igual ao dos espelhos
# wincred_*/giga_* explicados acima:
#
#   ERP_WRITE_ENABLED=true
#     Tira o BIPE DA SEPARAÇÃO do modo shadow e libera a baixa de estoque no
#     Flow (pick-scan, approveDebit, baixa da live). Não fala com servidor
#     nenhum. Desligar = a loja bipa a peça e o estoque não anda, calado.
#
#   PDV_ERP_OUTBOX (default ligado)
#     A fila `erp_outbox` é o VEÍCULO da baixa de estoque da venda do PDV.
#
# Quem for limpar o painel do Railway: não apague estas duas.

# ---- Aplicação ----
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# URL pública do frontend — usada pra travar CORS em produção.
# Aceita múltiplas separadas por vírgula:
#   FRONTEND_URL=https://flowops.vercel.app,https://flowops.lurds.com.br
FRONTEND_URL=http://localhost:3000

# ============================================
# Cadastro de produto — enriquecimento por IA
# ============================================

# ---- IA (enriquecimento de produto: título, descrição, tags) ----
# Pegue em: https://console.anthropic.com/settings/keys
# Sem essa chave a aba IA no modal mostra "desligado" — o CEO ainda
# consegue editar tudo à mão.
ANTHROPIC_API_KEY=
# Modelo opcional (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================
# LIVE OS — Instagram Live Commerce
# ============================================

# Meta App (developers.facebook.com → seu app → Settings → Basic)
META_APP_ID=
META_APP_SECRET=

# Verify token (string que VOCÊ inventa — cola a MESMA no painel Meta)
META_VERIFY_TOKEN=

# Token de longa duração da conta @lurdsplussize (60 dias)
# Gerado quando a conta aceitou ser Tester e autorizou o app
META_PAGE_ACCESS_TOKEN=

# ID numérico da conta @lurdsplussize
META_IG_USER_ID=

# Reservas — TTL padrão durante a live (em minutos)
LIVE_RESERVATION_TTL_MIN=15

# IA Anthropic (deixa em branco se ainda não tem chave)
# A "Lú" só responde se essa chave estiver configurada.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# ============================================
# Imóveis — publicação no portal público isolado
# ============================================
# URL pública da nova vitrine (sem barra final).
PUBLIC_PROPERTIES_BASE_URL=https://imoveis.lurds.com.br
# Endpoint completo do publicador implantado no projeto Vercel separado.
PUBLIC_PROPERTIES_SYNC_URL=https://imoveis.lurds.com.br/api/internal/publications/sync
# Mesmo segredo definido como PUBLICATION_SYNC_SECRET no portal público.
# Gere no mínimo 32 bytes aleatórios; nunca use JWT_SECRET aqui.
PUBLIC_PROPERTIES_SYNC_SECRET=
