model PurchaseOrder {
  id              String   @id @default(uuid())
  numero          Int      @unique @default(autoincrement())          // sequencial #1, #2...
  fornecedorNome  String   @map("fornecedor_nome")                   // ex: "MARRIE ARIMATH"
  fornecedorCnpj  String?  @map("fornecedor_cnpj")
  marca           String?                                              // fantasia do fornecedor (= MARCA na descrição)
  dataPedido      DateTime @default(now()) @map("data_pedido")
  dataPrevista    DateTime? @map("data_prevista")                     // SLA de chegada
  nfNumero        String?  @map("nf_numero")
  observacoes     String?  @db.Text
  // Status: rascunho | enviado | aguardando | recebido | cancelado
  status          String   @default("rascunho")
  // Calculados (atualizados quando salva items)
  totalPecas      Int      @default(0) @map("total_pecas")
  totalCusto      Float    @default(0) @map("total_custo")            // sem desconto/imposto
  totalLiquido    Float    @default(0) @map("total_liquido")
  totalVenda      Float    @default(0) @map("total_venda")            // soma preço venda × qty
  // Audit
  createdByUserId String?  @map("created_by_user_id")
  recebidoAt      DateTime? @map("recebido_at")
  recebidoByUserId String? @map("recebido_by_user_id")
  cadastroLog     String?  @map("cadastro_log") @db.Text               // JSON com resumo do auto-cadastro
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  items           PurchaseOrderItem[]

  @@index([status])
  @@index([fornecedorNome])
  @@index([dataPedido(sort: Desc)])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  // 1 linha = 1 REF + 1 COR + grade de tamanhos com qtd em cada.
  // Ex: REF 7031, COR PRETO, tamanhosQty = {"46": 21, "48": 21, "56": 18}
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  order           PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Identificação do produto
  ref             String                                               // REF do fornecedor
  descricaoBase   String   @map("descricao_base")                     // "CASACO SOFT" (do pedido)
  cor             String
  // Categoria (vem do CategoriaProduto OU preenchido manualmente)
  grupoCode       Int?     @map("grupo_code")
  grupoNome       String?  @map("grupo_nome")                         // "BLUSA FEMININA"
  subgrupoCode    Int?     @map("subgrupo_code")
  subgrupoNome    String?  @map("subgrupo_nome")                      // "ACADEMIA"
  ncm             String?
  cfop            String?  @default("5102")
  plusSize        Boolean  @default(true) @map("plus_size")
  // Classificação da peça (AtributoPeca) — preenchida NA COMPRA, porque quem
  // compra tem a peça na mão e sabe o tecido. Evita a segunda passada em
  // milhares de itens depois. O nome é gravado junto (mesma convenção do
  // grupoNome/subgrupoNome acima): se o cadastro for renomeado, o pedido
  // histórico continua mostrando o que foi escolhido na época.
  tecidoId        String?  @map("tecido_id")
  tecidoNome      String?  @map("tecido_nome")
  colecaoId       String?  @map("colecao_id")
  colecaoNome     String?  @map("colecao_nome")
  // Ocasião e modelagem aceitam VÁRIAS por peça (um vestido serve casamento e
  // jantar; valoriza cintura e alonga silhueta). JSON [{id,nome}] — mesma
  // escolha de `tamanhosQty`/`skusGerados`: o pedido de compra é registro
  // transacional, quem consulta por ocasião é a ficha do produto.
  ocasioes        String?  @db.Text
  modelagens      String?  @db.Text
  // Valores comerciais
  custoUnit       Float    @map("custo_unit")
  precoUnit       Float    @map("preco_unit")
  tributoPct      Float    @default(0) @map("tributo_pct")            // % de imposto (independente do NCM)
  descontoPct     Float    @default(0) @map("desconto_pct")
  // Grades — armazena qty por tamanho como JSON pra flexibilidade
  // formato: {"46": 21, "48": 21, "50": 21, ...}
  tamanhosQty     String   @map("tamanhos_qty") @db.Text              // JSON
  // Quando recebido, guarda qty REAL (pode ser menor que pedido)
  tamanhosQtyRecebida String? @map("tamanhos_qty_recebida") @db.Text  // JSON
  // SKUs gerados no Wincred após auto-cadastro (rastreabilidade)
  // formato: [{tam, codigoWincred, ean, qtdInserida}, ...]
  skusGerados     String?  @map("skus_gerados") @db.Text              // JSON
  // Status do ITEM (não confundir com status do pedido)
  // pendente | recebido | parcial | cancelado
  itemStatus      String   @default("pendente") @map("item_status")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([ref])
  @@map("purchase_order_items")
}

model CategoriaProduto {
  // Mapeamento "descrição da planilha" → Grupo+Subgrupo+NCM+CFOP.
  // Cadastrado 1x quando vem REF nova, reusa pra sempre.
  // Ex: descricaoBase="CASACO SOFT" → BLUSA FEMININA / ACADEMIA / NCM 61102000
  // NOTA: tributo NÃO está aqui — é por item (pode variar por fornecedor).
  id              String   @id @default(uuid())
  descricaoBase   String   @unique @map("descricao_base")             // PK lógica
  grupoCode       Int      @map("grupo_code")
  grupoNome       String   @map("grupo_nome")
  subgrupoCode   Int      @map("subgrupo_code")
  subgrupoNome   String   @map("subgrupo_nome")
  ncmDefault      String?  @map("ncm_default")
  cfopDefault     String?  @default("5102") @map("cfop_default")
  plusSizeDefault Boolean  @default(true) @map("plus_size_default")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("categoria_produtos")
}

model PropertyLog {
  // audit trail granular: 1 linha por mudança (campo, before/after, user, ts).
  // Usado pra timeline do imóvel + investigar quem mexeu no quê.
  id              String   @id @default(uuid())
  propertyId      String   @map("property_id")
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId          String?  @map("user_id")
  userName        String?  @map("user_name")
  action          String                                   // create | update | archive | unarchive | upload | delete_attachment
  scope           String?                                  // property | water | energy | iptu | tax | deed | scripture | attachment
  details         String?  @db.Text                        // JSON: { field, oldValue, newValue } ou descrição livre
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([propertyId, createdAt(sort: Desc)])
  @@map("property_logs")
}

// ════════════════════════════════════════════════════════════════════════
// ProductPhoto — fotos de produtos (por REF, opcionalmente por COR)
// Usado em Reposicao, PDV, Separacao, Realinhamento.
// Upload via R2 (mesma infra do Imobiliario).
// ════════════════════════════════════════════════════════════════════════
model ProductPhoto {
  id              String   @id @default(uuid())
  ref             String                              // REF do produto (Wincred)
  cor             String?                             // null = foto generica da REF
  url             String   @db.Text                   // URL publica no R2
  objectKey       String?  @map("object_key") @db.Text // chave no bucket pra delete
  uploadedByUserId String? @map("uploaded_by_user_id")
  // A vitrine do site precisa de GALERIA (até 6 por cor), não de uma foto só —
  // por isso a unicidade passou a incluir a ordem. `ordem` 0 é a capa.
  // Quem lê uma foto só (Reposição, PDV, Separação, Realinhamento) continua
  // funcionando: `getPhoto` ordena por `ordem` e devolve a capa.
  ordem           Int      @default(0)
  // Tamanho REAL do arquivo em pixels, medido no upload (13/08).
  // A PDP mostra a foto num quadro de ~513 CSS px e o monitor da cliente
  // costuma estar a 150%: abaixo de ~1400 de largura o navegador amplia e a
  // peça aparece borrada. Sem esta medida, foto pequena entrava em silêncio e
  // só dava as caras na vitrine. Nulo = foto anterior à medição.
  larguraPx       Int?     @map("largura_px")
  alturaPx        Int?     @map("altura_px")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([ref, cor, ordem], name: "ref_cor_ordem_unique")
  @@index([ref])
  @@map("product_photos")
}

// ═══════════════════════════════════════════════════════════════════════
// ESTOQUE — espelho do Wincred no PostgreSQL pra migração 30/06
// ═══════════════════════════════════════════════════════════════════════
// Fase 2 da migração Giga → Flowops. Sync via /retaguarda/estoque/sync
// pega da tabela `estoque` do Wincred (SELECT CODIGO, LOJA, ESTOQUE).
// Foco inicial nas 5 lojas migradas (INDAIATUBA, ITANHAEM, MOEMA, SOROCABA, SANTOS).
//
// Quando PDV finalizar venda, decrementa AQUI primeiro (read fast) + grava
// também no Giga via double-write. Quando Giga sair, é só remover a chamada.
model Stock {
  id        String   @id @default(uuid())
  storeCode String   @map("store_code")
  sku       String                          // CODIGO do Wincred
  qty       Int      @default(0)            // estoque disponível
  syncedAt  DateTime @default(now()) @map("synced_at")  // último sync do Giga
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeCode, sku])
  @@index([storeCode, qty])
  @@index([sku])
  @@map("stock")
}

// Log de toda movimentação de estoque — auditoria + reconciliação.
// reason: 'sync_giga' | 'sale' | 'return' | 'adjust' | 'transfer' | 'initial'
model StockMovement {
  id        String   @id @default(uuid())
  storeCode String   @map("store_code")
  sku       String
  delta     Int                              // negativo = saída, positivo = entrada
  qtyBefore Int      @map("qty_before")
  qtyAfter  Int      @map("qty_after")
  reason    String                           // categoria do movimento
  refId     String?  @map("ref_id")          // saleId / orderId / transferId
  note      String?                          // observação livre
  userId    String?  @map("user_id")         // quem fez (se aplicável)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([storeCode, sku, createdAt(sort: Desc)])
  @@index([reason, createdAt(sort: Desc)])
  @@index([refId])
  @@map("stock_movements")
}

// ════════════════════════════════════════════════════════════════════════
//  ERP OUTBOX — fila de escrita assíncrona no Giga/Wincred.
//
//  A venda finaliza SÓ no Postgres (instantâneo) e um job entra aqui.
//  Um processor (cron 30s) grava no Wincred (caixa + baixa de estoque) com
//  retry/backoff. Se o Giga estiver fora, a venda sai normal e o Wincred é
//  atualizado quando voltar. Sub-passos idempotentes: caixaDoneAt e
//  stockDoneAt marcam o que JÁ executou — retry nunca duplica INSERT na caixa.
// ════════════════════════════════════════════════════════════════════════
model ErpOutbox {
  id          String    @id @default(uuid())
  kind        String                          // 'venda' (finalize → caixa + estoque)
  saleId      String    @map("sale_id")
  payload     Json?                           // { finalMethod } — resto é re-lido do Postgres na hora
  status      String    @default("pending")   // pending | processing | done | failed
  attempts    Int       @default(0)
  caixaDoneAt DateTime? @map("caixa_done_at") // gravarVendaPdv OK (ou shadow)
  stockDoneAt DateTime? @map("stock_done_at") // decreaseStock OK (ou write desligado)
  lastError   String?   @map("last_error")
  nextRetryAt DateTime  @default(now()) @map("next_retry_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  doneAt      DateTime? @map("done_at")

  @@unique([kind, saleId])
  @@index([status, nextRetryAt])
  @@map("erp_outbox")
}

// ════════════════════════════════════════════════════════════════════════
//  WINCRED MIRROR — espelho 1:1 das 6 tabelas critícas do MySQL Wincred.
//
//  Estrategia: sync incremental por DATAALT (quando existir) + upsert.
//  Prefixo `wincred_*` deixa explicito que e espelho legacy. Quando
//  cut-over 30/06 acontecer, decidimos se mantemos prefixo ou renomeamos.
//
//  IMPORTANTE: estes models NAO sao a fonte da verdade para operações
//  novas (cadastro de produto, etc). Eles existem APENAS pra espelhar o
//  Wincred. Cadastro proprio = futura tabela `Product` sem prefixo.
// ════════════════════════════════════════════════════════════════════════

/// Espelho de wincred.produtos. Catalogo de SKUs.
/// PK = codigo (no Wincred nao tinha PK, vamos cravar — duplicatas viram update).
model WincredProduto {
  codigo            String    @id @db.VarChar(14)
  grupo             Int?
  nomeGrupo         String?   @db.VarChar(30)
  descricaoPdv      String?   @db.VarChar(50)
  descricaoCompleta String?   @db.VarChar(100)
  custo             Decimal?  @db.Decimal(10, 2)
  vendaUn           Decimal?  @db.Decimal(10, 2)
  fornecedor        String?   @db.VarChar(18)
  unidade           String?   @db.VarChar(2)
  estoque           Int?
  margem            Decimal?  @db.Decimal(10, 2)
  dataAlt           DateTime? @db.Date
  subgrupo          Int?
  cor               String?   @db.VarChar(15)
  tamanho           String?   @db.VarChar(20)
  marca             String?   @db.VarChar(30)
  ref               String?   @db.VarChar(10)
  codFornecedor     Int?
  operador          String?   @db.VarChar(15)
  confPreco         String?   @db.VarChar(3)
  tributo           String?   @db.VarChar(4)
  ncm               String?   @db.VarChar(8)
  plusSize          Int?
  idWincred         BigInt?
  categorias        String?   @db.VarChar(250)
  codPis            String?   @db.Char(2)
  aliqPis           Decimal?  @db.Decimal(10, 2)
  codCofins         String?   @db.Char(2)
  aliqCofins        Decimal?  @db.Decimal(10, 2)
  aliqIcms          Decimal?  @db.Decimal(10, 2)
  cst               String?   @db.Char(3)
  csosn             String?   @db.Char(3)
  cfop              Int?
  // EAN/código de barras (primeira coluna EAN-like preenchida no Giga —
  // EAN13/EAN/CODBARRAS variam por instalação; o sync sonda e copia).
  ean               String?   @db.VarChar(20)

  // Metadata de sync
  syncedAt          DateTime  @default(now()) @map("synced_at")

  @@index([ref, cor])
  @@index([dataAlt])
  @@index([grupo, subgrupo])
  @@index([plusSize, ref])
  @@index([descricaoCompleta])
  @@map("wincred_produtos")
}

/// Espelho de wincred.estoque. Qty por (codigo, loja).
/// PK composta replica o UNIQUE KEY uk_codigo_loja do Wincred.
model WincredEstoque {
  codigo   String  @db.VarChar(14)
  loja     String  @db.Char(2)
  estoque  Int?

  syncedAt DateTime @default(now()) @map("synced_at")

  @@id([codigo, loja])
  @@index([loja])
  @@map("wincred_estoque")
}

/// Espelho de wincred.grupos. Categorias.
model WincredGrupo {
  codigo Int    @id
  grupo  String? @db.VarChar(30)

  /// Nasceu no FLOW (31/07) e ainda pode não existir no Giga. O sync desta
  /// tabela é TRUNCATE + reinsere tudo do Giga; sem esta marca, uma categoria
  /// criada aqui seria APAGADA no ciclo seguinte, antes de a réplica sair.
  flowIsSource Boolean @default(false) @map("flow_is_source")

  syncedAt DateTime @default(now()) @map("synced_at")

  @@index([flowIsSource])
  @@map("wincred_grupos")
}

/// Sequência do Flow pros códigos de grupo/subgrupo de produto.
///
/// Faixa reservada a partir de 9000: o Giga usa até 433 hoje e as colunas são
/// int(11) nos dois lados (medido em scripts/giga-etl/medir-grupos.js), então
/// as duas numerações nunca se encontram. Código a partir de 9000 também
/// identifica de olho que a categoria nasceu no Flow.
/// Sequências dos cadastros criados no FLOW que precisam de código numérico
/// compatível com o Giga. Cada `tipo` tem sua faixa reservada, sempre muito
/// acima do que o Giga já usa, pra as duas numerações nunca se cruzarem.
///   grupo/subgrupo → 9.000+  (Giga usa até 433)
///   fornecedor     → 90.000+ (Giga usa até 10.526)
model CategoriaSequence {
  /// 'grupo' | 'subgrupo' | 'fornecedor'
  tipo      String   @id @db.VarChar(12)
  lastSeq   Int      @default(8999) @map("last_seq")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categoria_sequence")
}

/// Espelho de wincred.subgrupos. Sub-categorias.
model WincredSubgrupo {
  codigo   Int     @id
  subgrupo String? @db.VarChar(30)
  grupo    Int?

  /// Mesma razão do WincredGrupo: protege do TRUNCATE do sync.
  flowIsSource Boolean @default(false) @map("flow_is_source")

  syncedAt DateTime @default(now()) @map("synced_at")

  @@index([grupo])
  @@map("wincred_subgrupos")
}

/// Espelho de wincred.fornecedores.
model WincredFornecedor {
  codigo        Int       @id
  razaoSocial   String?   @db.VarChar(50)
  fantasia      String?   @db.VarChar(50)
  cnpj          String?   @db.VarChar(18)
  ie            String?   @db.VarChar(18)
  dataCadastro  DateTime? @db.Date
  endereco      String?   @db.VarChar(50)
  bairro        String?   @db.VarChar(30)
  cidade        String?   @db.VarChar(30)
  uf            String?   @db.Char(2)
  ddd           String?   @db.Char(5)
  fone          String?   @db.VarChar(16)
  fax           String?   @db.VarChar(16)
  cep           String?   @db.Char(10)
  email         String?   @db.VarChar(50)
  contato       String?   @db.VarChar(50)
  obs           Bytes?

  /// Nasceu no FLOW e pode ainda não existir no Giga. O sync desta tabela
  /// refaz o que veio de lá; sem esta marca, um fornecedor cadastrado aqui
  /// sumiria no ciclo seguinte — junto com o vínculo dele em Contas a Pagar.
  flowIsSource  Boolean   @default(false) @map("flow_is_source")
  /// Já replicado na `fornecedores` do Giga.
  gigaOk        Boolean   @default(false) @map("giga_ok")
  editedAt      DateTime? @map("edited_at")

  syncedAt      DateTime  @default(now()) @map("synced_at")

  @@index([cnpj])
  @@index([flowIsSource])
  @@map("wincred_fornecedores")
}

/// Espelho de wincred.codigos. Tabela de sequencia (1 linha apenas).
/// Wincred guarda proximo CODIGO disponivel pra cadastro.
/// PK = codigo (a propria coluna serve como identificador).
model WincredCodigo {
  codigo String @id @db.VarChar(13)

  syncedAt DateTime @default(now()) @map("synced_at")

  @@map("wincred_codigos")
}

/// Espelho de wincred.funcionarios — vendedoras ativas por loja (login do PDV).
/// Full replace de hora em hora junto com o GigaMirror. Tira o SELECT em
/// `funcionarios` do caminho quente do login das lojas.
/// PK sintética (29/07): o CÓDIGO repete entre lojas no Wincred — com
/// codigo como @id o espelho guardava UMA funcionária por código e o
/// ranking do Giga vestia o nome de OUTRA loja (Mirela de Campinas
/// aparecia como Pamela). Agora 1 linha por (codigo, loja).
model WincredFuncionario {
  id       Int     @id @default(autoincrement())
  codigo   String  @db.VarChar(14)
  nome     String? @db.VarChar(80)
  apelido  String? @db.VarChar(40)
  loja     String? @db.VarChar(4)
  inativo  Boolean @default(false)

  syncedAt DateTime @default(now()) @map("synced_at")

  @@index([codigo])
  @@index([loja])
  @@map("wincred_funcionarios")
}

/// Espelho DETALHADO de wincred.caixa — venda item a item (1 linha por item).
/// Janela deslizante: cron horário re-copia os últimos 3 dias; backfill desde
/// GIGA_MIRROR_FROM roda no boot quando a tabela está vazia (chunks mensais).
/// Destrava: dashboards ricos (top REFs/vendedoras/marcas/heatmap), consulta
/// de venda antiga/devolução manual e resumos de vendas SEM tocar o Giga.
model GigaCaixaMov {
  registro   String    @id @db.VarChar(20)
  numero     String?   @db.VarChar(20)
  controle   String?   @db.VarChar(20)
  codigo     String?   @db.VarChar(14)
  data       DateTime? @db.Date
  dataFec    DateTime? @map("data_fec") @db.Date
  hora       String?   @db.VarChar(10)
  descricao  String?   @db.VarChar(120)
  quantidade Decimal?  @db.Decimal(10, 2)
  valor      Decimal?  @db.Decimal(10, 2)
  valorTotal Decimal?  @map("valor_total") @db.Decimal(10, 2)
  operador   String?   @db.VarChar(30)
  vendedor   String?   @db.VarChar(40)
  cliente    String?   @db.VarChar(80)
  loja       String?   @db.VarChar(4)
  marcado    String?   @db.VarChar(4)
  // Colunas ricas do schema Lurd's (v2 14/07) — usadas pela tela de vendas
  // do caixa, clientes únicos e vendedoras. Sonda: ausentes viram NULL.
  codCliente    String?  @map("cod_cliente") @db.VarChar(20)
  nomeCliente   String?  @map("nome_cliente") @db.VarChar(80)
  cpf           String?  @db.VarChar(20)
  vendedora     String?  @db.VarChar(40)
  vendedoraCode String?  @map("vendedora_code") @db.VarChar(14)
  fpag          String?  @db.VarChar(30)
  obsPedido     String?  @map("obs_pedido") @db.VarChar(200)
  valorUnitario Decimal? @map("valor_unitario") @db.Decimal(10, 2)

  syncedAt DateTime @default(now()) @map("synced_at")

  @@index([data])
  @@index([loja, data])
  @@index([codigo])
  @@index([dataFec])
  @@map("giga_caixa_mov")
}

/// Espelho ENXUTO de wincred.movimento — SÓ parcelas de crediário EM ABERTO.
/// Full replace de hora em hora + write-through nas baixas do Flow. A tela
/// de cobrança (listAllOpenInstallments) lê daqui — a query que varria a
/// tabela movimento inteira no Giga (5.000 linhas / teto 30s) vira local.
model WincredMovimentoAberto {
  registro      String    @id
  controle      String?
  numeroCompra  String?   @map("numero_compra")
  loja          String?   @db.VarChar(4)
  codCliente    String?   @map("cod_cliente")
  nome          String?
  parcela       Int?
  totalParcelas Int?      @map("total_parcelas")
  vencimento    DateTime? @db.Date
  valorParcela  Decimal?  @map("valor_parcela") @db.Decimal(10, 2)
  // Observação livre da promissória (movimento.OBS do Giga). Sem esta coluna
  // o espelho devolvia obs=null e a observação "sumia" da tela de
  // recebimentos quando a leitura migrou pro espelho (05/08).
  obs           String?   @db.VarChar(300)

  syncedAt      DateTime  @default(now()) @map("synced_at")

  @@index([vencimento])
  @@index([codCliente])
  @@index([loja])
  @@map("wincred_movimento_aberto")
}

/// Espelho SLIM de clientes do Giga — nome + telefones pra cobrança/
/// recebimentos funcionarem com o Giga fora do ar.
/// ⚠️ CHAVE COMPOSTA (loja, codCliente): o CODIGO de cliente do Wincred se
/// REPETE entre lojas — cada loja tem sua numeração e seu crediário separado.
/// Antes (codCliente @id global) o sync sobrescrevia o cliente de uma loja
/// com o de outra. loja = char(2) do Giga; '00' = linha legada pré-migração
/// (o cron das 4h / primeira carga regrava tudo com a loja certa).
model WincredCliente {
  loja       String   @default("00") @db.VarChar(2)
  codCliente String   @map("cod_cliente")
  nome       String?
  telefone   String?
  telefone2  String?

  syncedAt   DateTime @default(now()) @map("synced_at")

  @@id([loja, codCliente])
  @@index([codCliente])
  @@map("wincred_clientes")
}

/// CLIENTES DO GIGA — importação COMPLETA da tabela `clientes` (dono, 21/07:
/// "puxe a tabela exatamente igual ao Giga com todos os campos e importe tudo").
/// Base da futura tela de Consulta de Clientes nativa (substitui a do Giga) e
/// do crediário nativo. Colunas conhecidas viram campos estruturados/indexados;
/// a LINHA ORIGINAL INTEIRA fica em rawJson — NENHUM campo se perde, mesmo os
/// que o mapeamento não reconhece (RG/exp, cônjuge, pai/mãe, autorizados,
/// referências, etc). Chave (loja, codigo): o CODIGO se repete entre lojas.
model GigaCliente {
  loja            String    @default("00") @db.VarChar(4)
  codigo          String    @db.VarChar(20)
  personId        String?   @map("person_id")
  nome            String?   @db.VarChar(120)
  cpf             String?   @db.VarChar(20)
  rg              String?   @db.VarChar(30)
  nascimento      DateTime? @db.Date
  email           String?   @db.VarChar(120)
  foneRes         String?   @map("fone_res") @db.VarChar(30)
  foneCel         String?   @map("fone_cel") @db.VarChar(30)
  foneRec         String?   @map("fone_rec") @db.VarChar(30)
  falarCom        String?   @map("falar_com") @db.VarChar(60)
  endereco        String?   @db.VarChar(120)
  numero          String?   @db.VarChar(15)
  complemento     String?   @db.VarChar(60)
  bairro          String?   @db.VarChar(60)
  cidade          String?   @db.VarChar(60)
  uf              String?   @db.VarChar(2)
  cep             String?   @db.VarChar(12)
  bloqueado       String?   @db.VarChar(5)
  avaliacao       String?   @db.VarChar(4)
  situacao        String?   @db.VarChar(30)
  pontos          Decimal?  @db.Decimal(12, 2)
  limiteCompras   Decimal?  @map("limite_compras") @db.Decimal(12, 2)
  aberturaCredito DateTime? @map("abertura_credito") @db.Date
  localTrabalho   String?   @map("local_trabalho") @db.VarChar(120)
  salario         Decimal?  @db.Decimal(12, 2)
  admissao        DateTime? @db.Date
  observacao      String?   @db.Text
  rawJson         Json      @map("raw_json")
  // ── INTEGRAÇÃO (uma PESSOA só — site + lojas + live) ──
  // personKey = "cpf:<dígitos>" (MESMA convenção do CRM/customer-aggregation).
  // Registros da mesma pessoa em N lojas compartilham o personKey; customerId
  // aponta pro Customer mestre do CRM quando o CPF/fone casa.
  personKey       String?   @map("person_key")
  customerId      String?   @map("customer_id")
  // ── FONTE DA VERDADE (mesmo padrão do Product) ──
  // flowIsSource=true → ficha editada/criada NO FLOW; o sync do Giga NUNCA
  // sobrescreve; a réplica vai Flow→Giga pelo outbox (kind cliente_upsert).
  flowIsSource    Boolean   @default(false) @map("flow_is_source")
  editedAt        DateTime? @map("edited_at")
  editedBy        String?   @map("edited_by")
  syncedAt        DateTime  @default(now()) @map("synced_at")
  person          Person?   @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([loja, codigo])
  @@index([nome])
  @@index([cpf])
  @@index([codigo])
  @@index([personKey])
  @@index([customerId])
  @@index([personId])
  @@map("giga_clientes")
}

/// CREDIÁRIO NATIVO — FASE 1 do Tier 3 do "sair da Giga" (21/07).
/// Ledger COMPLETO de parcelas importado do `movimento` do Giga (abertas E
/// pagas — todo o histórico), com a camada nativa pro Flow virar fonte:
///   flowIsSource=true → parcela criada/baixada NO FLOW (fase 2); o sync do
///   Giga nunca sobrescreve; réplica vai Flow→Giga pelo outbox.
///   saleId/baixaId → rastreio da venda PDV e da baixa que quitou (fase 2).
/// Chave = REGISTRO do Giga. Parcela nova do Flow (fase 2) usará faixa própria.
model CrediarioParcela {
  registro      String    @id @db.VarChar(20)
  personId      String?   @map("person_id")
  controle      String?   @db.VarChar(20)
  numeroCompra  String?   @map("numero_compra") @db.VarChar(20)
  loja          String    @default("00") @db.VarChar(4)
  codCliente    String?   @map("cod_cliente") @db.VarChar(20)
  nomeCliente   String?   @map("nome_cliente") @db.VarChar(120)
  parcela       Int?
  totalParcelas Int?      @map("total_parcelas")
  dataCompra    DateTime? @map("data_compra") @db.Date
  valorCompra   Decimal?  @map("valor_compra") @db.Decimal(10, 2)
  vencimento    DateTime? @db.Date
  valorParcela  Decimal?  @map("valor_parcela") @db.Decimal(10, 2)
  pago          Boolean   @default(false)
  dataPagamento DateTime? @map("data_pagamento") @db.Date
  valorPago     Decimal?  @map("valor_pago") @db.Decimal(10, 2)
  juros         Decimal?  @db.Decimal(10, 2)
  multa         Decimal?  @db.Decimal(10, 2)
  obs           String?   @db.VarChar(300)
  // ── Camada NATIVA (fase 2: Flow fonte da verdade) ──
  flowIsSource  Boolean   @default(false) @map("flow_is_source")
  saleId        String?   @map("sale_id")
  baixaId       String?   @map("baixa_id")
  editedAt      DateTime? @map("edited_at")
  syncedAt      DateTime  @default(now()) @map("synced_at")

  // ══════ RÉPLICA PRO GIGA (31/07) — ack POR LINHA ══════
  /// A linha já foi replicada na `movimento` do Giga.
  gigaOk      Boolean   @default(false) @map("giga_ok")
  gigaAt      DateTime? @map("giga_at")
  gigaError   String?   @map("giga_error") @db.VarChar(300)
  /// A BAIXA desta parcela já foi replicada. O full-replace nunca pode apagar
  /// uma linha com baixa ainda não replicada — perderia o pagamento.
  baixaGigaOk Boolean   @default(false) @map("baixa_giga_ok")

  /// Venda cancelada. A linha NUNCA é deletada — some das leituras e o worker
  /// se recusa a replicar. Apagar dívida é irreversível; esconder não é.
  cancelado    Boolean   @default(false)
  canceladoEm  DateTime? @map("cancelado_em")
  canceladoPor String?   @map("cancelado_por") @db.VarChar(80)
  person       Person?   @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([loja, codCliente])
  @@index([codCliente])
  @@index([pago, vencimento])
  @@index([numeroCompra])
  @@index([flowIsSource])
  /// ANTI-DUPLICATA determinístico, imposto pelo BANCO. É a defesa principal
  /// contra cobrar a cliente duas vezes: clique duplo, timeout com repetição,
  /// retry do outbox ou dois PDVs na mesma loja esbarram todos aqui, sem
  /// depender de sonda nem de janela de tempo.
  /// As 710.589 linhas legadas têm saleId NULL, e o Postgres trata NULLs como
  /// distintos — o índice sobe sem conflito com o histórico.
  @@unique([saleId, parcela], name: "uniq_parcela_por_venda")
  @@index([saleId])
  @@index([personId])
  @@index([flowIsSource, gigaOk])
  @@index([flowIsSource, pago, cancelado])
  @@map("crediario_parcelas")
}

/// SEQUÊNCIA DO CREDIÁRIO CRIADO NO FLOW.
///
/// REGISTRO e CONTROLE numerados aqui, numa faixa alta reservada — mesma ideia
/// do EAN prefixo 8 e do pedido do ecommerce na faixa 950M.
///
/// Medido em 31/07 (`scripts/giga-etl/medir-numeracao-crediario.js`):
///   REGISTRO  int(11)  maior em uso 712.606   teto 2.147.483.647
///   CONTROLE  int(11)  maior em uso 341.518   teto 2.147.483.647
/// Base 900.000.000 fica 899 milhões acima do uso e 1,2 bilhão abaixo do teto.
///
/// SEM @default nos contadores DE PROPÓSITO: se a linha não existir, o update
/// estoura e o endpoint cai no caminho legado. Começar do zero criaria códigos
/// que colidem com o histórico — vazio não é resposta válida.
model CrediarioSeq {
  /// 'registro' | 'controle'
  escopo    String   @id @db.VarChar(20)
  /// Início da faixa do Flow. O alocador LEGADO lê daqui pra EXCLUIR a faixa
  /// do seu MAX+1 — sem isso as duas numerações colidem assim que a primeira
  /// parcela do Flow for replicada.
  base      BigInt
  proximo   BigInt
  /// Teto do tipo no MySQL, com margem.
  teto      BigInt
  /// Auditoria: os MAX medidos e quando.
  seedFonte String?  @map("seed_fonte") @db.VarChar(400)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crediario_seq")
}

/// ══════════ CONVÊNIO (sindicato — dono 21/07) ══════════
/// "Cartão de crédito" da loja conveniada (ex.: Indaiatuba × sindicato):
/// associado compra sem pagar na hora; a loja FATURA O SINDICATO no dia de
/// fechamento (consolidado, por associado); sindicato paga e desconta em
/// folha. Limite POR CICLO: disponível = limite − compras ainda não faturadas
/// (fechou a fatura → sindicato assume → limite renova).
model Convenio {
  id            String   @id @default(uuid())
  nome          String   @db.VarChar(80)
  storeCode     String   @map("store_code") @db.VarChar(4)  // SÓ vale nesta loja
  diaFechamento Int      @default(20) @map("dia_fechamento")
  ativo         Boolean  @default(true)
  obs           String?  @db.VarChar(300)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  membros ConvenioMembro[]
  compras ConvenioCompra[]
  faturas ConvenioFatura[]

  @@index([storeCode, ativo])
  @@map("convenios")
}

/// Associado — SÓ a lista que o sindicato manda (nome + limite). Sem ficha.
model ConvenioMembro {
  id          String   @id @default(uuid())
  convenioId  String   @map("convenio_id")
  nome        String   @db.VarChar(120)
  matricula   String?  @db.VarChar(30)
  limiteCents Int      @default(0) @map("limite_cents")
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  convenio Convenio         @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  compras  ConvenioCompra[]

  @@index([convenioId, ativo])
  @@index([convenioId, nome])
  @@map("convenio_membros")
}

/// Compra no convênio (criada quando a venda PDV finaliza com pgto 'convenio').
/// faturaId null = ciclo aberto (conta no limite do associado).
model ConvenioCompra {
  id         String   @id @default(uuid())
  convenioId String   @map("convenio_id")
  membroId   String   @map("membro_id")
  storeCode  String   @map("store_code") @db.VarChar(4)
  saleId     String?  @map("sale_id")
  valorCents Int      @map("valor_cents")
  faturaId   String?  @map("fatura_id")
  createdAt  DateTime @default(now()) @map("created_at")

  convenio Convenio        @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  membro   ConvenioMembro  @relation(fields: [membroId], references: [id])
  fatura   ConvenioFatura? @relation(fields: [faturaId], references: [id])

  @@index([convenioId, faturaId])
  @@index([membroId, faturaId])
  @@index([saleId])
  @@map("convenio_compras")
}

/// Fatura mensal pro sindicato (consolidada, por associado no detalhe).
model ConvenioFatura {
  id         String    @id @default(uuid())
  convenioId String    @map("convenio_id")
  de         DateTime  @db.Date
  ate        DateTime  @db.Date
  totalCents Int       @default(0) @map("total_cents")
  status     String    @default("aberta") // aberta | paga
  geradaEm   DateTime  @default(now()) @map("gerada_em")
  pagaEm     DateTime? @map("paga_em")
  obs        String?   @db.VarChar(300)

  convenio Convenio         @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  compras  ConvenioCompra[]

  @@index([convenioId, status])
  @@map("convenio_faturas")
}

/// Sequência de CÓDIGO pra cliente NOVO cadastrado no Flow (por loja).
/// Começa em 500001 — faixa alta que NUNCA colide com a numeração do Giga
/// (mesma ideia do EAN prefixo-8 dos produtos: o Flow é dono do código novo).
model GigaClienteSeq {
  loja      String   @id @db.VarChar(4)
  proximo   Int      @default(500001)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("giga_cliente_seq")
}

/// MARCADOS NATIVOS (provar em casa) — fonte de leitura no Flow (21/07).
/// Import da caixa do Giga (MARCADO='SIM') + atualizado na hora pelas
/// operações do Flow (marcar / puxar pra venda / devolver). registroGiga
/// amarra na linha da caixa pra réplica (fechar = DELETE lá).
model Marcado {
  id           String    @id @default(cuid())
  personId     String?   @map("person_id")
  registroGiga BigInt?   @unique @map("registro_giga")
  storeCode    String    @map("store_code") @db.VarChar(4)
  codCliente   String    @map("cod_cliente") @db.VarChar(20)
  clienteNome  String?   @map("cliente_nome") @db.VarChar(120)
  cpf          String?   @db.VarChar(20)
  numero       Int?      // CONTROLE/NUMERO do Giga (agrupa a marcação)
  sku          String    @db.VarChar(60)
  descricao    String?   @db.VarChar(160)
  qty          Int       @default(1)
  valorUnit    Decimal   @default(0) @map("valor_unit") @db.Decimal(12, 2)
  valorTotal   Decimal   @default(0) @map("valor_total") @db.Decimal(12, 2)
  vendedor     String?   @db.VarChar(80)
  dataMarcacao DateTime? @map("data_marcacao") @db.Date
  /// ativo | fechado (virou venda no Flow) | devolvido | fechado_giga (sumiu do Giga)
  /// | baixado (write-off SEM financeiro/estoque — defeito, furto, perda)
  status       String    @default("ativo") @db.VarChar(16)
  saleId       String?   @map("sale_id")
  fechadoAt    DateTime? @map("fechado_at")
  devolvidoAt  DateTime? @map("devolvido_at")
  baixadoAt    DateTime? @map("baixado_at")
  baixaMotivo  String?   @map("baixa_motivo") @db.VarChar(160)
  baixaPor     String?   @map("baixa_por") @db.VarChar(120)
  /// giga (import/sync) | flow (marcado criado pelo PDV)
  origem       String    @default("giga") @db.VarChar(10)
  isTraining   Boolean   @default(false) @map("is_training")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  person       Person?   @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([status, codCliente])
  @@index([status, storeCode])
  @@index([status, cpf])
  @@index([personId])
  @@map("marcados")
}

/// Estado do sync incremental. 1 linha por tabela.
/// Cron incremental usa lastDataAlt pra pegar so produtos modificados desde
/// o ultimo run (WHERE DATAALT > lastDataAlt). Estoque nao tem DATAALT — re-syncamos
/// estoque apenas dos produtos modificados (delta menor).
model WincredSyncState {
  tabela        String   @id @db.VarChar(30)
  lastRunAt     DateTime @default(now()) @map("last_run_at")
  lastDataAlt   DateTime? @map("last_data_alt") @db.Date
  lastRowCount  Int?     @map("last_row_count")
  lastStatus    String?  @db.VarChar(20)
  lastError     String?  @db.Text

  @@map("wincred_sync_state")
}

// ═══════════════════════════════════════════════════════════════════════════
// LIVE COMMERCE (operador) — módulo "Live PDV"
//
// Diferente do módulo Live/Instagram (orientado a comentários + estoque
// virtual). Aqui a APRESENTADORA opera ao vivo: busca REF, clica no tam/cor,
// identifica a cliente e reserva contra o ESTOQUE REAL CONSOLIDADO da rede.
//
// Fluxo:
//   1. Sessão da live aberta (loja da live = Anália Franco por padrão).
//   2. Operadora busca produto e clica numa célula da grade → cria LivePdvItem
//      (reserva com TTL). A loja de ORIGEM é escolhida automaticamente pelo
//      RoutingEngine (maior estoque → folga → prioridade → proximidade).
//   3. Reserva expira sozinha (cron) se não pagar dentro do TTL.
//   4. Pagamento PIX (Pagar.me/PagBank) confirma → itens viram 'paid' e
//      geram ordem de separação pra cada loja de origem.
//   5. Loja origem separa/despacha → cria TransferOrder (tipo LIVE) origem→
//      loja-da-live + InterStoreObligation (÷2,5) pra conciliação contábil.
// ═══════════════════════════════════════════════════════════════════════════
model LivePdvSession {
  id                String   @id @default(uuid())
  title             String
  status            String   @default("live")          // scheduled | live | ended
  liveStoreCode     String   @map("live_store_code")    // loja "dona" da venda (Anália Franco)
  liveStoreName     String   @map("live_store_name")
  reservationTtlMin Int      @default(30) @map("reservation_ttl_min")
  startedAt         DateTime? @map("started_at")
  endedAt           DateTime? @map("ended_at")
  createdByUserId   String?  @map("created_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  carts             LivePdvCart[]
  items             LivePdvItem[]
  atalhos           LivePdvAtalho[]

  @@index([status, createdAt(sort: Desc)])
  @@map("live_pdv_sessions")
}

/// LEGENDA DA LIVE — sequência de produtos com ATALHO curto (01, 02, ...).
/// A equipe monta e VALIDA antes da transmissão (mesma rotina searchGrade da
/// live); durante a live o operador digita só o atalho e o searchGrade
/// converte pra referência completa antes da busca normal.
model LivePdvAtalho {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  atalho    String   // código curto normalizado (trim + UPPER) — único por sessão
  refCode   String   @map("ref_code")  // referência COMPLETA validada (o termo que o operador digitaria)
  descricao String?  // snapshot da descrição na validação (exibição na lista)
  // Cor VENDIDA nesta legenda (13/07): digitar o atalho abre a grade SÓ dessa
  // cor. Null = todas as cores (comportamento antigo).
  cor       String?  @db.VarChar(40)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session   LivePdvSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, atalho])
  @@index([sessionId, position])
  @@map("live_pdv_atalhos")
}

model LivePdvCart {
  id                String   @id @default(uuid())
  personId          String?  @map("person_id")
  sessionId         String   @map("session_id")
  cartNumber        Int?     @map("cart_number")         // nº sequencial da comanda por sessão (busca por número)
  customerId        String?  @map("customer_id")        // FK lógico p/ Customer (sem relação p/ não tocar Customer)
  customerName      String   @map("customer_name")
  customerPhone     String   @map("customer_phone")
  customerInstagram String?  @map("customer_instagram")
  customerCpf       String?  @map("customer_cpf")
  customerEmail     String?  @map("customer_email")
  customerCep       String?  @map("customer_cep")
  // Endereço de entrega (capturado no ato do PIX; CEP puxa via ViaCEP).
  customerEndereco    String? @map("customer_endereco")     // logradouro
  customerNumero      String? @map("customer_numero")
  customerComplemento String? @map("customer_complemento")
  customerBairro      String? @map("customer_bairro")
  customerCidade      String? @map("customer_cidade")
  customerUf          String? @map("customer_uf")
  // Código curto do link público de pagamento (/p/<code>) — 8 chars aleatórios.
  // Substitui o UUID gigante no link que a cliente recebe no WhatsApp/Direct.
  payCode           String?  @unique @map("pay_code")
  // open | awaiting_payment | paid | separating | shipped | delivered | cancelled
  status            String   @default("open")
  subtotalCents     Int      @default(0) @map("subtotal_cents")
  freteCents        Int      @default(0) @map("frete_cents")
  totalCents        Int      @default(0) @map("total_cents")
  paymentMethod     String?  @map("payment_method")     // pix
  pagarmeOrderId    String?  @map("pagarme_order_id")
  qrCodeText        String?  @map("qr_code_text")        @db.Text
  qrCodeImageUrl    String?  @map("qr_code_image_url")   @db.Text
  paymentExpiresAt  DateTime? @map("payment_expires_at")
  paidAt            DateTime? @map("paid_at")
  // Quando a DM automática de cobrança (ManyChat) foi enviada — a cobrança em
  // massa PULA quem já recebeu (não repete DM); o botão individual reenvia.
  dmSentAt          DateTime? @map("dm_sent_at")
  // COBRANÇA AUTOMÁTICA POR WHATSAPP (11/07): carrinho parado → template
  // individual com o link exato via ManyChat API. 1 envio por carrinho;
  // tentativas limita retry em falha (não vira spam de erro).
  cobrancaWhatsEnviadaAt  DateTime? @map("cobranca_whats_enviada_at")
  cobrancaWhatsTentativas Int       @default(0) @map("cobranca_whats_tentativas")
  cobrancaWhatsCount      Int       @default(0) @map("cobranca_whats_count")
  cobrancaDirectCount     Int       @default(0) @map("cobranca_direct_count")
  // SACOLA PELA DM (16/07): a cliente montou o carrinho sozinha pelo ManyChat.
  // selfCart marca a origem (apresentadora confere com atenção). awaitingReview
  // = cliente digitou FECHAR e a sacola está na FILA DE REVISÃO — a cobrança NÃO
  // sai sozinha; a apresentadora confere e libera (liberarCobranca). É a
  // "verificação antes de finalizar" exigida pelo dono. clientClosedAt = quando
  // ela fechou. Gated por LIVE_DM_SELFCART=1.
  selfCart          Boolean   @default(false) @map("self_cart")
  awaitingReview    Boolean   @default(false) @map("awaiting_review")
  clientClosedAt    DateTime? @map("client_closed_at")
  // RETIRADA EM LOJA (igual ao site): frete zero, prazo de até 7 dias úteis.
  // A cliente escolhe a loja no checkout; endereço deixa de ser obrigatório.
  isPickup          Boolean  @default(false) @map("is_pickup")
  pickupStoreCode   String?  @map("pickup_store_code")
  pickupStoreName   String?  @map("pickup_store_name")
  // TRILHO DO SITE (12/07): ao liberar a separação, a venda da live vira um
  // Order normal (source='live') e segue o fluxo do site (pick-orders, bip,
  // baixa, envio). orderId aponta pro Order gerado; o cart vira só o registro
  // da venda na live (cobrança/pagamento) + espelho de status.
  orderId           String?  @unique @map("order_id")
  // CORREIOS: id da pré-postagem gerada pra este carrinho (pra reimprimir a
  // etiqueta). O código de rastreio fica em LivePdvItem.trackingCode.
  correiosPrepostagemId String? @map("correios_prepostagem_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  session           LivePdvSession @relation(fields: [sessionId], references: [id])
  items             LivePdvItem[]
  person            Person? @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([sessionId, cartNumber])
  @@index([sessionId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([personId])
  @@map("live_pdv_carts")
}

model LivePdvItem {
  id                String   @id @default(uuid())
  cartId            String   @map("cart_id")
  sessionId         String   @map("session_id")
  refCode           String   @map("ref_code")
  itemKey           String   @map("item_key")           // REF|COR|TAM normalizado — chave de reserva
  codigoBipado      String?  @map("codigo_bipado")       // CODIGO Giga resolvido (baixa de estoque sem ambiguidade)
  descricao         String?
  cor               String?
  tamanho           String?
  qty               Int      @default(1)
  priceCents        Int      @map("price_cents")          // preço efetivo cobrado (promo da live se houver)
  basePriceCents    Int      @default(0) @map("base_price_cents") // preço cheio (sem promo) — base do custo e do "de/por"
  custoCents        Int      @map("custo_cents")         // basePriceCents / 2.5 (valor de custo p/ conciliação)
  originStoreCode   String   @map("origin_store_code")
  originStoreName   String   @map("origin_store_name")
  originManual      Boolean  @default(false) @map("origin_manual")  // supervisor trocou a loja manualmente
  // reserved | paid | separating | shipped | delivered | cancelled | expired
  status            String   @default("reserved")
  reservedAt        DateTime @default(now()) @map("reserved_at")
  expiresAt         DateTime @map("expires_at")
  paidAt            DateTime? @map("paid_at")
  separatedAt       DateTime? @map("separated_at")
  shippedAt         DateTime? @map("shipped_at")
  deliveredAt       DateTime? @map("delivered_at")
  trackingCode      String?  @map("tracking_code")
  // Carimbo do aviso de rastreio pra cliente (WhatsApp/DM) — 1 msg por código
  trackingNotifiedAt DateTime? @map("tracking_notified_at")
  transferOrderId   String?  @map("transfer_order_id")   // transferência interna gerada no despacho
  obligationId      String?  @map("obligation_id")        // obrigação intercompany gerada
  cancelledAt       DateTime? @map("cancelled_at")
  cancelReason      String?  @map("cancel_reason")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  cart              LivePdvCart    @relation(fields: [cartId], references: [id])
  session           LivePdvSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, status])
  @@index([itemKey, status])
  @@index([originStoreCode, status])
  @@index([cartId])
  @@map("live_pdv_items")
}

// Preço promocional da live — definido pela atendente em tempo real, por
// produto (REF) dentro de uma sessão. Vale pra novos itens e atualiza os
// itens ainda RESERVADOS (não pagos). priceCents=preço promo em centavos.
model LivePdvPromo {
  id              String   @id @default(uuid())
  sessionId       String   @map("session_id")
  refCode         String   @map("ref_code")        // REF normalizada (uppercase)
  priceCents      Int      @map("price_cents")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, refCode])
  @@map("live_pdv_promos")
}

// Vínculo @ do Instagram → ID de assinante do ManyChat, alimentado em tempo
// real pelo webhook público (automação "External Request" do ManyChat) e
// também pelo importador de CSV. A cobrança automática da live resolve o ID
// daqui quando a cliente ainda não tem Customer.manychatSubscriberId — cobre
// carrinho criado na mão pela apresentadora (cliente nunca clicou no link).
model LiveManychatSubscriber {
  id           String   @id @default(uuid())
  igUsername   String   @unique @map("ig_username") // sem @, lowercase
  subscriberId String   @map("subscriber_id")
  name         String?
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("live_manychat_subscribers")
}

// ─────────────────────────────────────────────────────────────────────────
// ESPELHO (ghost) do Giga — tabelas sincronizadas de hora em hora pelo
// GigaMirrorService. A conta corrente LÊ DAQUI (Postgres), nunca do Giga ao
// vivo → instantâneo, sem circuit-breaker, sem blip. O único ponto que fala
// com o Giga é o sync; se ele tropeça, tenta no próximo ciclo e a tela nem vê.
// ─────────────────────────────────────────────────────────────────────────

// Transferências agregadas por (origem, destino, documento, dia) — exatamente
// o grão que a cascata da conta corrente consome. totalPreco = soma de venda.
model GigaTransferencia {
  id         String   @id @default(cuid())
  ljOrigem   String   @map("lj_origem")
  ljDestino  String   @map("lj_destino")
  controle   String
  data       DateTime @db.Date
  qty        Int
  totalPreco Float    @map("total_preco")
  syncedAt   DateTime @default(now()) @map("synced_at")

  @@index([data])
  @@index([ljOrigem, ljDestino])
  @@map("giga_transferencia")
}

// Venda bruta por (loja, dia), já líquida de MARCADO='SIM'. Royalties somam por
// mês a partir daqui.
model GigaCaixaDiario {
  id       String   @id @default(cuid())
  loja     String
  data     DateTime @db.Date
  bruto    Float
  syncedAt DateTime @default(now()) @map("synced_at")

  @@index([data])
  @@index([loja])
  @@map("giga_caixa_diario")
}

// Estado do sync (1 linha por tabela): última vez OK, erro, nº de linhas.
model GigaMirrorState {
  id         String    @id @default(cuid())
  tabela     String    @unique
  lastSyncAt DateTime? @map("last_sync_at")
  lastOkAt   DateTime? @map("last_ok_at")
  lastError  String?   @map("last_error")
  rows       Int       @default(0)
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("giga_mirror_state")
}

// Itens (peças/SKU) de cada transferência — o nível mais fundo da cascata.
// Grão: (origem, destino, documento, CODIGO, dia). Carregado sob demanda quando
// o usuário abre uma transferência específica (não vai no payload do extrato).
model GigaTransferenciaItem {
  id         String   @id @default(cuid())
  ljOrigem   String   @map("lj_origem")
  ljDestino  String   @map("lj_destino")
  controle   String
  codigo     String
  descricao  String?
  data       DateTime @db.Date
  qty        Int
  totalPreco Float    @map("total_preco")
  syncedAt   DateTime @default(now()) @map("synced_at")

  @@index([controle])
  @@index([data])
  @@map("giga_transferencia_item")
}

// Catálogo de produtos do Giga (espelho). Grão: 1 linha por CODIGO (SKU).
// Sincronizado pelo GigaMirrorService (no máx. a cada ~6h — catálogo muda devagar).
model GigaProduto {
  id        String   @id @default(cuid())
  codigo    String
  ref       String?
  // REF-BASE canônica (13/07): a REF sem o sufixo de variante que o cadastro
  // da Giga inventa na mão ("VLM-222P"/"VLM-222 VD" → "VLM-222"; "900658M" →
  // "900658"). Regra: corta o que vem DEPOIS do último dígito — "VLM-2225"
  // fica inteiro (dígito é parte do núcleo, produto DIFERENTE). A grade da
  // live agrupa a família por esta coluna. Preenchida no sync + backfill boot.
  refBase   String?  @map("ref_base")
  descricao String?
  cor       String?
  tamanho   String?
  grupo     String?
  ncm       String?
  vendaUn   Float?   @map("venda_un")
  syncedAt  DateTime @default(now()) @map("synced_at")

  @@index([codigo])
  @@index([ref])
  @@index([refBase])
  @@map("giga_produto")
}

// Espelho do ESTOQUE do Giga por loja (CODIGO x LOJA). Usado como FALLBACK na
// Live quando o Giga ao vivo cai — nunca como fonte primária (estoque exato é
// sempre o ao vivo). Sync de hora em hora (full replace).
model GigaEstoque {
  id       String   @id @default(cuid())
  codigo   String
  loja     String
  estoque  Int
  syncedAt DateTime @default(now()) @map("synced_at")

  @@index([codigo])
  @@map("giga_estoque")
}

/// Classificação BÁSICO/MODA por REFERÊNCIA (modelo). Owned 100% pelo Flow —
/// vive no Postgres e sobrevive aos syncs do ERP (que truncam wincred_produtos).
/// NÃO altera nada no Giga/Wincred ao vivo. Cruzada com o catálogo do ERP por REF.
///
/// Granularidade = REF (não SKU): básico/moda é característica do modelo, então
/// uma REF classificada vale pra todas as suas cores/tamanhos.
///
/// ref = REF do ERP normalizada (TRIM + UPPER). Produto SEM registro aqui =
/// tipoProduto 0 (MODA) e NÃO revisado, conforme a regra da tela.
model ProductClassification {
  ref                   String   @id @db.VarChar(20)
  tipoProduto           Int      @default(0) @map("tipo_produto") // 0=MODA, 1=BASICO
  classificacaoRevisada Boolean  @default(false) @map("classificacao_revisada")
  /// LIBERADA NA MÃO pra promoção, mesmo fora da regra de data.
  ///
  /// A promo pega quem foi cadastrado até 31/12/2023 (ou REF -INV/-VER). Peça
  /// nova que o dono quer liquidar ficava de fora, e a saída seria falsear a
  /// `dataAlt` do catálogo — que é a chave do sync incremental e do
  /// "recém-cadastrado". Mentir na data resolveria a promo e deixaria a mentira
  /// pra próxima regra ler. Aqui a exceção fica explícita, reversível e com
  /// autor (`updatedBy`/`updatedAt` já existem nesta tabela).
  promoLiberada         Boolean  @default(false) @map("promo_liberada")
  updatedBy             String?  @map("updated_by")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([tipoProduto])
  @@index([classificacaoRevisada])
  @@map("product_classification")
}

/// GRADE DE MEDIDAS — template reutilizável (busto/cintura/quadril por tamanho).
///
/// Digitar matriz de medidas em cada peça é o caminho garantido pra ficar tudo
/// vazio. Aqui a grade é cadastrada uma vez ("Vestido viscolycra 46-60") e a
/// ficha só aponta pra ela; quando aquela peça foge do padrão, a própria ficha
/// guarda o ajuste em `medidasAjuste`.
model GradeMedidas {
  id         String   @id @default(uuid())
  nome       String   @unique
  observacao String?  @db.Text
  /// JSON: [{ tamanho: "46", busto: 96, cintura: 80, quadril: 104, comprimento: 112 }]
  /// Medidas em centímetros. Campo ausente = não se aplica àquela peça.
  linhas     String   @db.Text
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  fichas     ProdutoFicha[]

  @@map("grades_medidas")
}

/// FICHA DO PRODUTO — nível REF (o que vale pra TODAS as cores).
///
/// A cascata da tela master é REF → COR → grade. Sem este nível, tecido e
/// modelagem teriam que ser redigitados em cada cor da mesma peça.
///
/// Chave é REF + MARCA, nunca REF sozinha: REF numérica é reciclada entre
/// fornecedores (dois "222" de marcas diferentes são peças diferentes).
///
/// Só guarda o que o Flow ACRESCENTA. Preço, estoque, grupo/subgrupo e EANs
/// continuam vindo do catálogo — aqui é a camada de enriquecimento.
model ProdutoFicha {
  id            String   @id @default(uuid())
  ref           String
  marca         String
  /// Derivado da descrição (sem cor/tamanho/ref/marca), editável.
  nomeCurto     String?  @map("nome_curto")
  /// Descrição de venda. UMA por REF: as cores da mesma peça têm o mesmo
  /// tecido e o mesmo caimento, e escrever três vezes quase a mesma coisa é o
  /// que faz o campo ficar vazio.
  descricao     String?  @db.Text

  // Classificação — mesma convenção do pedido de compra: id + nome ao lado.
  tecidoId      String?  @map("tecido_id")
  tecidoNome    String?  @map("tecido_nome")
  colecaoId     String?  @map("colecao_id")
  colecaoNome   String?  @map("colecao_nome")
  /// JSON [{id,nome}] — aceitam várias por peça.
  ocasioes      String?  @db.Text
  modelagens    String?  @db.Text

  // Caimento
  gradeMedidasId String? @map("grade_medidas_id")
  gradeMedidas   GradeMedidas? @relation(fields: [gradeMedidasId], references: [id])
  /// Ajuste da grade só pra esta peça. Mesmo formato de `GradeMedidas.linhas`;
  /// o que estiver aqui sobrescreve a linha do template.
  medidasAjuste  String? @map("medidas_ajuste") @db.Text
  /// 'nao' | 'pouco' | 'muito' — pergunta que a cliente mais faz.
  elasticidade   String?

  /// RESUMO DE VITRINE — 2 a 3 linhas, o que a cliente lê antes do "Ver mais".
  ///
  /// A `descricao` acima passa de 40 linhas na peça bem cadastrada: o texto vem
  /// pronto do fornecedor/site antigo e mistura venda com ficha. Este campo é o
  /// mesmo conteúdo destilado — não substitui a descrição, abre a leitura dela.
  resumo         String?  @db.Text
  /// FICHA TÉCNICA — JSON `[{rotulo,valor}]`: forro, transparência, decote,
  /// manga, comprimento, composição.
  ///
  /// Formato livre de propósito. Tecido, modelagem e elasticidade têm campo
  /// próprio porque viram FILTRO; estes só são exibidos, e criar cinco colunas
  /// pra texto curto engessaria a lista na primeira peça que precisar de um
  /// item a mais ("bojo removível", "fenda lateral").
  fichaTecnica   String?  @map("ficha_tecnica") @db.Text
  /// Quando a extração por IA passou por aqui. É o CURSOR do lote: sem ele o
  /// mutirão reprocessa as mesmas peças e cobra de novo por elas.
  iaEm           DateTime? @map("ia_em")

  atualizadoPor String?  @map("atualizado_por")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cores         ProdutoFichaCor[]

  @@unique([ref, marca])
  @@index([tecidoId])
  @@index([colecaoId])
  @@map("produto_ficha")
}

/// FICHA DO PRODUTO — nível COR. É a página do site: uma por cor.
///
/// Preço mora aqui e não na REF porque varia mesmo por cor (VLM-222 laranja e
/// marinho a R$ 179,90, marrom a R$ 189,90) — mas quem manda no preço é o
/// catálogo; esta tabela só guarda o que o site acrescenta.
model ProdutoFichaCor {
  id             String   @id @default(uuid())
  fichaId        String   @map("ficha_id")
  ficha          ProdutoFicha @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  cor            String
  /// Título da página no site. Vazio = monta com nome curto + cor.
  tituloComercial String? @map("titulo_comercial")
  /// Vídeo da peça. Guarda a URL como veio; o site extrai o id.
  youtubeUrl     String?  @map("youtube_url")
  /// 'publicado' | 'pronto' | 'sem_fotos' | 'nao_publicar'
  /// ⚠️ 'sem_fotos' é CALCULADO na leitura (não tem foto no R2), nunca
  /// escolhido a dedo — status digitado desatualiza no dia seguinte.
  statusPublicacao String @default("nao_publicar") @map("status_publicacao")

  /// BOLINHA do seletor de cor no site. A cliente escolhe a cor clicando nela,
  /// e a galeria troca pelas fotos daquela cor.
  ///
  /// 'cor'  = círculo pintado com `corHex`, pego a conta-gotas na própria foto
  ///          (a cor da peça na luz da foto bate mais com o que chega do que
  ///          qualquer tabela de nome de cor).
  /// 'foto' = recorte da foto, pra ESTAMPA — floral, poá, tie-dye não cabem
  ///          num hex só. `swatchFoco*` (0..1) é o ponto da foto que fica no
  ///          centro do círculo, ampliado.
  swatchTipo       String  @default("cor") @map("swatch_tipo")
  corHex           String? @map("cor_hex")
  swatchFocoX      Float?  @map("swatch_foco_x")
  swatchFocoY      Float?  @map("swatch_foco_y")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([fichaId, cor])
  @@map("produto_ficha_cor")
}

/// ATENDIMENTO DO SITE — a conversa da cliente com a assistente.
///
/// Guarda a conversa INTEIRA, e não só o lead: quando a cliente pede uma
/// consultora, quem atende precisa saber o que já foi perguntado — repetir a
/// pergunta é a forma mais rápida de perder a venda que a assistente segurou.
///
/// `status`:
///   'ativa'      → conversando com a IA
///   'aguardando' → pediu humano; está na fila da retaguarda
///   'atendida'   → uma consultora assumiu
///   'encerrada'  → resolvida sem humano
model SiteChat {
  id          String   @id @default(uuid())
  /// Anônimo por sessão do navegador — a cliente não precisa se identificar
  /// pra tirar dúvida.
  sessaoId    String   @map("sessao_id")
  /// Preenchido quando ela está logada (cookie da conta) — aí a assistente
  /// enxerga os pedidos dela.
  customerId  String?  @map("customer_id")

  /// [{ papel: 'cliente'|'assistente', texto, em }]
  mensagens   String   @db.Text

  /// Deixados quando ela pede atendimento humano.
  nome        String?
  whatsapp    String?
  /// O que ela estava vendo quando chamou — encurta o atendimento.
  contexto    String?  @db.Text

  status      String   @default("ativa")
  atendidaPor String?  @map("atendida_por")
  atendidaEm  DateTime? @map("atendida_em")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@index([sessaoId])
  @@map("site_chats")
}

/// IMPORTAÇÃO EM LOTE DAS FOTOS DO SITE ANTIGO.
///
/// O estado do lote mora no BANCO, e não na memória do processo, por uma lição
/// cara de 03/08: deploy reinicia o backend em ~30s e mata o que estava em
/// andamento. Job em memória morreria no meio e ninguém saberia até alguém
/// reparar que faltou foto. Aqui a retomada é automática — o cron pega o job
/// aberto de onde parou.
///
/// `refs` é a fila completa e `indice` o cursor. Reprocessar é inofensivo: a
/// importação pula cor que já tem foto.
model FotoImportJob {
  id           String   @id @default(uuid())
  /// 'rodando' | 'concluido' | 'cancelado'
  status       String   @default("rodando")

  /// JSON: lista de REFs a processar, na ordem.
  refs         String   @db.Text
  indice       Int      @default(0)
  total        Int      @default(0)

  fotos        Int      @default(0)
  bolinhas     Int      @default(0)
  refsComFoto  Int      @default(0) @map("refs_com_foto")
  /// Foi pro site. A importacao NAO publicava (07/08): 1.172 REFs ganharam
  /// foto e nenhuma aparecia na vitrine nem na busca.
  publicadas   Int      @default(0)
  /// Ganhou foto mas ficou fora do site por NAO estar ativa no WooCommerce
  /// (rascunho la = decisao de nao mostrar). Contado pra nao sumir calado.
  semEstoque   Int      @default(0) @map("sem_estoque")
  /// JSON: [{ ref, motivo }] — o que não deu certo, pra revisão manual.
  problemas    String?  @db.Text

  refAtual     String?  @map("ref_atual")
  criadoPor    String?  @map("criado_por")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@map("foto_import_jobs")
}

/// FRETE DO SITE — a régua que a loja mexe sozinha (itens 22 a 25).
///
/// Singleton. Até 04/08/2026 o frete grátis era `FREE_SHIPPING_FROM = 399.9`
/// chumbado no código do e-commerce e o prazo era o do transportador puro —
/// mudar qualquer um dos dois exigia deploy.
///
/// `diasSeparacao` é a diferença entre o prazo do transportador e o prazo que
/// a cliente lê. Prometer o prazo dos Correios cru é prometer que a peça sai
/// no mesmo dia; ela ainda vai ser separada na loja, conferida e postada.
model SiteFreteConfig {
  id                 String    @id @default("singleton")

  /// Frete grátis: régua, janela e recorte de região (CSV de UF; vazio = todas).
  freteGratisAtivo   Boolean   @default(true) @map("frete_gratis_ativo")
  freteGratisMinimo  Float     @default(499.9) @map("frete_gratis_minimo")
  freteGratisInicio  DateTime? @map("frete_gratis_inicio")
  freteGratisFim     DateTime? @map("frete_gratis_fim")
  freteGratisUfs     String?   @map("frete_gratis_ufs") @db.VarChar(120)

  /// Somado ao prazo do transportador (dono, 04/08).
  diasSeparacao      Int       @default(2) @map("dias_separacao")

  /// Retirada em loja: em quantas horas a peça fica pronta e o que a cliente
  /// precisa levar. Vai na tela de entrega, não numa página de ajuda.
  retiradaPrazoHoras Int       @default(3) @map("retirada_prazo_horas")
  retiradaInstrucoes String?   @map("retirada_instrucoes") @db.Text

  atualizadoPor      String?   @map("atualizado_por") @db.VarChar(80)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("site_frete_config")
}

/// TABELA PROMOCIONAL DE FRETE (item 23) — o preço que a cliente vê.
///
/// Decisão do dono (04/08): o site NÃO mostra a cotação como preço padrão.
/// Mostra tabela promocional — SP SEDEX R$ 9,99, e RJ/MG/PR/SC/RS PAC R$ 19,99
/// — e a cotação real do contrato entra só como opção expressa (e como preço
/// cheio nas demais UFs).
///
/// `ufs` é CSV ("SP" ou "RJ,MG,PR,SC,RS"). `prazoMin/Max` nulos = usa o prazo
/// que os Correios devolverem (mais o `diasSeparacao`) — promoção muda preço,
/// não muda o tempo que o carro leva.
model SiteFretePromo {
  id       String    @id @default(uuid())
  /// O que aparece na tela ("Correios PAC", "SEDEX").
  label    String    @db.VarChar(60)
  /// 'pac' | 'sedex' — casa com o serviço cotado pra herdar o prazo.
  servico  String    @db.VarChar(10)
  ufs      String    @db.VarChar(120)
  preco    Float
  prazoMin Int?      @map("prazo_min")
  prazoMax Int?      @map("prazo_max")
  ativo    Boolean   @default(true)
  inicioEm DateTime? @map("inicio_em")
  fimEm    DateTime? @map("fim_em")
  ordem    Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([ativo, ordem])
  @@map("site_frete_promo")
}

/// CUPOM DO SITE — a regra de desconto mora AQUI, não no código do e-commerce.
///
/// Item 3 da lista de lançamento ("recalcular o cupom no servidor") e item 55
/// ("editável, com criação na retaguarda"). Até 04/08/2026 a tabela de cupons
/// era um array em `ecommerce/src/lib/commerce/cupom.ts`: criar um cupom de
/// campanha exigia commit + deploy, e quem recalculava era o BFF do site —
/// não o dono do pedido.
///
/// O `code` é a chave: sempre MAIÚSCULO, sem espaço. O backend normaliza antes
/// de gravar e antes de procurar, então "bemvinda10" e "BemVinda10" são o
/// mesmo cupom (a cliente digita como quiser).
///
/// `tipo` diz onde o desconto cai:
///   'percent'  → % sobre o subtotal das peças
///   'fixed'    → R$ fixos sobre o subtotal
///   'shipping' → zera o frete ECONÔMICO (nunca o expresso — quem quer SEDEX
///                paga SEDEX; ver a tabela promocional do bloco B)
///
/// `usoMaximo`/`usos` existem pra cupom de campanha morrer sozinho depois de N
/// pedidos. Nulo = ilimitado.
model SiteCupom {
  code           String    @id @db.VarChar(30)
  /// Frase curta que a cliente lê quando aplica ("Boas-vindas: 10% off").
  label          String    @db.VarChar(80)
  tipo           String    @default("percent") @db.VarChar(12)
  /// percent: 0–100 · fixed: reais · shipping: ignorado.
  valor          Float     @default(0)

  /// Pedido mínimo em reais pra valer. Nulo = sem mínimo.
  minSubtotal    Float?    @map("min_subtotal")
  /// Só pra quem nunca comprou no site (checado por CPF no CRM).
  primeiraCompra Boolean   @default(false) @map("primeira_compra")
  /// Restringe às categorias comerciais listadas (CSV, minúsculo). Vazio = todas.
  categorias     String?   @db.VarChar(300)

  /// Janela de validade — campanha entra e sai sozinha, sem ninguém acordar.
  inicioEm       DateTime? @map("inicio_em")
  fimEm          DateTime? @map("fim_em")

  usoMaximo      Int?      @map("uso_maximo")
  usos           Int       @default(0)
  ativo          Boolean   @default(true)

  /// ── VALE-TROCA (item 85) ──────────────────────────────────────────────
  /// Cupom de campanha é público: quem tiver o código usa. Vale-troca é
  /// DINHEIRO de uma pessoa específica — o código vaza num print de WhatsApp
  /// e vira compra de outra. Preenchido = só este CPF usa (só dígitos).
  cpf            String?   @db.VarChar(11)
  /// 'campanha' (padrão) | 'troca'. Separa o que a retaguarda pode editar à
  /// vontade do que é crédito de cliente e tem dono.
  origem         String    @default("campanha") @db.VarChar(12)
  /// Troca que originou o vale — a auditoria de "de onde veio esse dinheiro".
  trocaId        String?   @map("troca_id")
  /// Venda do PDV que consumiu o vale. Existe pelo mesmo motivo que
  /// `pdvReturn.creditoUsadoEm`: cancelar a venda tem que DEVOLVER o crédito,
  /// e devolver só é seguro quando dá pra provar que foi ESTA venda que gastou.
  usadoPdvSaleId String?   @map("usado_pdv_sale_id")
  usadoAt        DateTime? @map("usado_at")

  atualizadoPor  String?   @map("atualizado_por") @db.VarChar(80)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([ativo, fimEm])
  @@index([cpf])
  @@index([trocaId])
  @@map("site_cupons")
}

/// BANNER DA VITRINE — o que a loja troca sozinha, sem deploy.
///
/// Até 03/08/2026 o hero da home, a tarja do topo e as faixas editoriais eram
/// constantes em `ecommerce/src/data/content.ts`: trocar a foto da campanha
/// exigia commit + build + deploy. Aqui viram dado.
///
/// `slot` é onde o banner aparece — o site pede por slot e nunca por id, então
/// trocar a campanha é editar a linha, não mexer no código:
///   'home-hero'   → o banner grande da home (foto, título, dois botões)
///   'home-faixa'  → faixas editoriais no meio da home
///   'tarja-topo'  → as frases que giram na tarja preta acima do menu
///
/// Janela (`inicioEm`/`fimEm`) existe pra campanha entrar e sair sozinha de
/// madrugada — ninguém precisa acordar pra tirar o banner do Dia das Mães.
/// CATEGORIA DA VITRINE — a cara de /categoria/<slug> (dono 07/08).
///
/// A categoria em si NASCE do CRM (campo `categoria` do SiteProduto): esta
/// tabela não cria nem apaga categoria, só VESTE a que já existe — foto,
/// nome de exibição, texto e ordem no menu. Sem linha aqui, o site segue
/// com o nome derivado do slug e sem foto, como hoje.
/// Coleção CURADA e ORDENADA de peças (ex.: "Mais Top da Semana" — os 20 que o dono
/// mais quer vender na semana). É PARALELA à categoria real da peça: NÃO troca
/// `SiteProduto.categoria` (a blusa continua em Blusas), diferente de classificar. Uma
/// linha por coleção; `refs` = array ORDENADO de REF (a mesma REF do feed/pixel). A
/// ordem do array É a ordem na vitrine e no carimbo do feed. Alimenta: página do site,
/// item do menu e o `custom_label_1=top-semana` do feed do Meta.
model SiteColecao {
  slug          String   @id
  nome          String?
  refs          Json     @default("[]")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")
  atualizadoPor String?  @map("atualizado_por")

  @@map("site_colecao")
}

model SiteCategoria {
  id            String   @id @default(uuid())

  /// PAI, quando esta linha é uma SUBCATEGORIA.
  ///
  /// `null` = categoria de primeiro nível ("Blusas"), que aparece no menu e
  /// tem página própria. Preenchido = subcategoria ("Manga curta", com
  /// `paiSlug: 'blusas'`), que aparece como FILTRO dentro da página do pai.
  ///
  /// Auto-referência em vez de tabela separada porque subcategoria precisa de
  /// exatamente o mesmo que categoria: nome de vitrine, ordem, ativo, foto.
  /// Duas tabelas seriam duas telas e duas regras pra manter iguais.
  ///
  /// Árvore do SITE, não do Giga (dono, 10/08/2026: "esquece Giga"). O
  /// grupo/subgrupo de lá é fiscal ("BLUSA FEMININA"), estava em 3% do
  /// catálogo, e vive num espelho recriado por TRUNCATE a cada sync.
  paiSlug       String?  @map("pai_slug")

  /// O mesmo slug que o produto carrega ("vestidos", "moda-praia").
  slug          String   @unique
  /// Como aparece no menu e no título. Vazio = derivado do slug.
  nome          String?
  /// Título da página ("Vestidos plus size") — SEO e cabeçalho.
  titulo        String?
  /// Parágrafo de abertura da página da categoria.
  intro         String?  @db.Text

  imagemUrl     String?  @map("imagem_url") @db.Text
  objectKey     String?  @map("object_key") @db.Text
  alt           String?
  /// Qual REF gerou `imagemUrl` quando ela veio do automático (peça mais
  /// nova da categoria) — permite recalcular o foco só quando a foto MUDA,
  /// sem reprocessar toda vez que a página carrega. Nulo = foto escolhida
  /// à mão na retaguarda (nunca é trocada sozinha).
  imagemDeRef   String?  @map("imagem_de_ref")
  /// Centro do RECORTE — fração 0..1 da peça que representa a categoria
  /// ("as calças", não o corpo inteiro). Lido pela IA (dono 07/08: "trate as
  /// fotos pra dar mais close na peça que simboliza a categoria"); null =
  /// sem leitura ainda, o card usa o enquadramento padrão (topo da foto).
  focoX         Float?   @map("foco_x")
  focoY         Float?   @map("foco_y")
  /// Quanto ampliar a partir do foco pra virar "close" — 1 = sem zoom.
  focoZoom      Float?   @map("foco_zoom")

  /// Ordem no menu. Empate resolve pela quantidade de peças.
  ordem         Int      @default(0)
  /// Aparece no menu do site. Peça continua achável pela busca de qualquer forma.
  ativo         Boolean  @default(true)
  /// Ganha o card editorial grande do mega menu.
  destaque      Boolean  @default(false)

  atualizadoPor String?  @map("atualizado_por")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([ativo, ordem])
  /// O menu monta a árvore buscando os filhos de cada categoria.
  @@index([paiSlug])
  @@map("site_categorias")
}

/// DE-PARA entre a categoria do WooCommerce e a categoria do site.
///
/// A classificação da peça vinha de um mapa FIXO no código
/// (`SiteSyncService.MAPA_CATEGORIA`): "vestido"→vestidos, "blusa"→blusas.
/// Categoria do WooCommerce fora desse mapa não resolvia, e a peça caía no
/// palpite pelo nome — que é onde "Conjunto Lingerie" ia parar em Conjuntos
/// (10/08/2026). Corrigir exigia mexer em código e fazer deploy.
///
/// Esta tabela põe a decisão na mão de quem cadastra. O sync consulta ela
/// PRIMEIRO; o mapa do código vira só o padrão de fábrica.
///
/// Também é o INVENTÁRIO do que chega: toda categoria vista no sync é
/// registrada aqui, mapeada ou não, com quantas peças vieram com ela. É como
/// a retaguarda descobre que existe uma categoria nova no WooCommerce
/// esperando destino — sem isso, a peça sumiria da vitrine e ninguém saberia
/// por quê.
model SiteCategoriaMapa {
  id            String   @id @default(uuid())
  /// Nome da categoria do WooCommerce, normalizado (minúscula, sem acento).
  /// É a chave de busca do sync.
  origem        String   @unique
  /// Como estava escrito no WooCommerce — só pra exibir na tela.
  origemRotulo  String?  @map("origem_rotulo")
  /// Slug da categoria do site. `null` = ainda não decidido (a peça fica sem
  /// categoria). String vazia = IGNORAR de propósito (categoria do WC que não
  /// vira vitrine, tipo "Promoções" ou "Novidades").
  destino       String?
  /// Quantas peças vieram com esta categoria no último sync — ordena a tela
  /// pelo que mais dói deixar sem destino.
  pecas         Int      @default(0)
  vistoEm       DateTime @default(now()) @map("visto_em")
  atualizadoPor String?  @map("atualizado_por")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([destino])
  @@map("site_categoria_mapa")
}

model SiteBanner {
  id              String    @id @default(uuid())
  slot            String
  eyebrow         String?
  titulo          String?
  /// Palavra de ênfase do título — o site quebra a linha e joga em itálico
  /// dourado ("Elegância não tem" / *tamanho*).
  destaque        String?
  subtitulo       String?   @db.Text

  imagemUrl       String?   @map("imagem_url") @db.Text
  /// Opcional: recorte vertical pro celular. Vazio = usa a mesma foto.
  imagemMobileUrl String?   @map("imagem_mobile_url") @db.Text
  objectKey       String?   @map("object_key") @db.Text
  objectKeyMobile String?   @map("object_key_mobile") @db.Text
  alt             String?

  ctaLabel        String?   @map("cta_label")
  ctaHref         String?   @map("cta_href")
  cta2Label       String?   @map("cta2_label")
  cta2Href        String?   @map("cta2_href")

  ordem           Int       @default(0)
  ativo           Boolean   @default(true)
  inicioEm        DateTime? @map("inicio_em")
  fimEm           DateTime? @map("fim_em")

  atualizadoPor   String?   @map("atualizado_por")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([slot, ativo, ordem])
  @@map("site_banners")
}

/// LEAD DO SITE — quem deixou nome, celular e e-mail no popup do cupom.
///
/// SEPARADO do `Customer` de propósito (decisão do dono, 12/08/2026). Aqui é
/// gente que AINDA NÃO COMPROU: jogar lead de popup na base mestra suja a
/// ficha de quem compra, embaralha LTV e faz o CRM prometer cliente que nunca
/// existiu. Quando ela compra, o pedido cria/atualiza o cadastro normal pelos
/// caminhos que já existem — e é aí que ela vira cliente de verdade.
///
/// A CHAVE É O TELEFONE (só dígitos), a mesma identidade que o CRM usa pra
/// deduplicar. Ela volta e preenche de novo? Atualiza a linha e MANTÉM o
/// cupom e a data do primeiro cadastro: cupom que muda a cada visita é convite
/// pra ninguém confiar no primeiro.
model SiteLead {
  id          String   @id @default(uuid())
  nome        String   @db.VarChar(120)
  /// Só dígitos, com DDD (11 ou 10 posições). Identidade da pessoa.
  telefone    String   @unique @db.VarChar(11)
  email       String   @db.VarChar(160)

  /// Cupom entregue a ela. Guardado na linha (e não deduzido depois) pra
  /// sobreviver a mudança de campanha: se o código do popup virar outro
  /// amanhã, a promessa feita a ESTA pessoa continua registrada.
  cupom       String   @db.VarChar(30)
  /// Em que página ela se cadastrou — diz qual vitrine converte lead.
  origem      String?  @db.VarChar(200)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// A tela da retaguarda lista por data (filtro De/Até) — sem índice, varre
  /// a tabela inteira a cada troca de período.
  @@index([createdAt])
  @@map("site_lead")
}

/// Checkout identificado antes do pedido existir. Guarda somente contato e
/// snapshot comercial; nunca recebe CPF, e-mail ou dados de cartão.
model CheckoutRecovery {
  id          String    @id @default(uuid())
  sessionId   String    @unique @map("session_id") @db.VarChar(64)
  anonymousId String?   @map("anonymous_id") @db.VarChar(64)
  nome        String    @db.VarChar(120)
  telefone    String    @db.VarChar(11)
  recoveryConsent Boolean @default(false) @map("recovery_consent")
  status      String    @default("active") @db.VarChar(20)
  subtotal    Decimal?  @db.Decimal(12, 2)
  items       Json
  path        String?   @db.VarChar(200)
  attribution Json?
  convertedAt DateTime? @map("converted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@index([telefone])
  @@map("checkout_recoveries")
}

/// BASE DE MARKETING PRÓPRIA (dono, 14/08/2026).
///
/// Os 171 mil contatos de e-mail viviam SÓ no Mautic (mkt.lurds.com.br). O
/// Mautic e o SES são da casa (não do prestador que operava), mas base de
/// marketing que mora numa única ferramenta é base refém: um servidor que cai,
/// uma conta que expira, um operador que sai — e o ativo mais valioso da loja
/// (quem já demonstrou interesse) some. Aqui é a CÓPIA soberana, no nosso
/// Postgres, alimentada por importação (Mautic → `importar-mautic-contatos.js`)
/// e, no futuro, pelo próprio funil do site.
///
/// NÃO é o CRM (`Customer`/`Person`, base de QUEM COMPROU) nem o lead do popup
/// (`SiteLead`, quem trocou telefone por cupom). É a MAILING LIST: e-mail é a
/// identidade, e a maioria aqui nunca comprou no site novo — é justamente pra
/// quem a gente quer vender.
model MarketingContact {
  id              String    @id @default(uuid())
  /// Identidade: minúsculo, sem espaço. Upsert por aqui — reimportar não duplica.
  email           String    @unique @db.VarChar(180)
  nome            String?   @db.VarChar(160)
  /// Só dígitos com DDD quando veio; a mailing de e-mail nem sempre tem telefone.
  telefone        String?   @db.VarChar(13)
  /// De onde veio a linha: 'mautic', 'popup', 'pedido'… — pra medir origem e
  /// nunca disparar num público que não deu opt-in.
  origem          String?   @db.VarChar(60)
  /// Segmento/tag no sistema de origem ("GERAL ATIVO", "Leads VIP"): é o corte
  /// que a campanha usa. Vários por contato — guardado como CSV simples.
  tags            String?   @db.VarChar(400)
  /// Engajamento herdado do Mautic (points) — ajuda a priorizar quem abrir.
  pontos          Int?
  /// Última atividade conhecida na origem — separa lista morta de lista viva.
  ultimaAtividade DateTime? @map("ultima_atividade")
  /// OPT-OUT é sagrado: quem descadastrou NUNCA volta a receber, venha de onde
  /// vier a reimportação. A checagem é daqui, não da campanha.
  descadastrado   Boolean   @default(false)
  descadastradoEm DateTime? @map("descadastrado_em")
  /// Id do contato no Mautic — reconcilia reimportação e liga de volta à origem.
  mauticId        String?   @map("mautic_id") @db.VarChar(20)
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  @@index([descadastrado])
  @@index([origem])
  @@map("marketing_contact")
}

/// CLASSIFICAÇÃO DA PEÇA — Ocasião, Tecido, Modelagem e Coleção.
///
/// Uma tabela só, separada por `tipo`, porque os quatro têm exatamente a mesma
/// forma (nome, slug, descrição, foto de capa). São QUATRO telas de cadastro
/// distintas na retaguarda; o que é compartilhado é o armazenamento. Eixo novo
/// (ex.: "estampa") nasce sem migration.
///
/// O `slug` é o que vira URL no site (/ocasioes/casamento), então é único por
/// tipo. `fotoUrl` é a capa da página desse eixo na vitrine.
///
/// ⚠️ Como não há FK por tipo, quem grava `tecidoId` num pedido tem que validar
/// que o id é mesmo de um tecido — a checagem vive no AtributosPecaService.
model AtributoPeca {
  id        String   @id @default(uuid())
  /// 'ocasiao' | 'tecido' | 'modelagem' | 'colecao'
  tipo      String
  nome      String
  slug      String
  descricao String?  @db.Text
  fotoUrl   String?  @map("foto_url")
  /// Desativar esconde do site e dos selects, sem apagar o histórico de quem
  /// já foi classificado com ele.
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tipo, slug])
  @@index([tipo, ativo, ordem])
  @@map("atributos_peca")
}

/// Auditoria do EDITOR DE PRODUTOS (/retaguarda/editor-produtos): cada campo
/// alterado vira uma linha ANTES→DEPOIS, agrupada por batchId (um "Confirmar").
/// applied=false = shadow mode (EDITOR_PRODUTOS_WRITE=0, só logou sem gravar).
model ProductEditAudit {
  id        String   @id @default(cuid())
  batchId   String   @map("batch_id")
  codigo    String   @db.VarChar(20)
  ref       String?  @db.VarChar(20)
  field     String   @db.VarChar(30)
  oldValue  String?  @map("old_value") @db.VarChar(200)
  newValue  String?  @map("new_value") @db.VarChar(200)
  userName  String?  @map("user_name") @db.VarChar(120)
  applied   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([batchId])
  @@index([codigo])
  @@index([createdAt])
  @@map("product_edit_audit")
}

/// PRODUTO NATIVO DO FLOW (migração "sair da Giga", fase produtos P1-P3).
/// Nasce como cópia curada do espelho wincred_produtos (catálogo inteiro) e
/// ganha a camada que o Giga nunca teve: genero, categoria, liveOk, ativo.
/// Campos do espelho usam os MESMOS nomes do WincredProduto — permite trocar
/// o model nas leituras (flag PRODUCT_NATIVE_READS) sem reescrever queries.
/// flowIsSource=true → a linha foi editada NO FLOW (fonte da verdade); o sync
/// do espelho NUNCA mais sobrescreve os campos dela (replicação vai Flow→Giga).
/// curadoManual=true → genero/liveOk definidos na mão; sync não recalcula.
model Product {
  codigo            String    @id @db.VarChar(14)
  grupo             Int?
  nomeGrupo         String?   @db.VarChar(30)
  descricaoPdv      String?   @db.VarChar(50)
  descricaoCompleta String?   @db.VarChar(100)
  custo             Decimal?  @db.Decimal(10, 2)
  vendaUn           Decimal?  @db.Decimal(10, 2)
  fornecedor        String?   @db.VarChar(18)
  unidade           String?   @db.VarChar(2)
  estoque           Int?
  margem            Decimal?  @db.Decimal(10, 2)
  dataAlt           DateTime? @db.Date
  subgrupo          Int?
  cor               String?   @db.VarChar(15)
  tamanho           String?   @db.VarChar(20)
  marca             String?   @db.VarChar(30)
  ref               String?   @db.VarChar(10)
  ncm               String?   @db.VarChar(8)
  tributo           String?   @db.VarChar(4)
  cfop              Int?
  plusSize          Int?
  ean               String?   @db.VarChar(20)

  // ── Camada NATIVA (não existe no Giga) ──
  genero       String?   @db.VarChar(12) // FEMININO | MASCULINO | INFANTIL
  categoria    String?   @db.VarChar(30)
  liveOk       Boolean   @default(false) // apto pra busca da LIVE (plus feminino)
  ativo        Boolean   @default(true)
  curadoManual Boolean   @default(false) @map("curado_manual")
  flowIsSource Boolean   @default(false) @map("flow_is_source")
  editedAt     DateTime? @map("edited_at")

  syncedAt  DateTime @default(now()) @map("synced_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ref])
  @@index([ref, cor])
  @@index([liveOk])
  @@index([genero])
  @@index([flowIsSource])
  @@map("product")
}

/// OperadorPin — PIN pessoal de liberação no PDV, por PESSOA (CPF), global (vale
/// em qualquer loja). Substitui a "senha compartilhada de nível" pelo PIN de cada
/// funcionária, mantendo a hierarquia (nivel) — e passa a saber QUEM autorizou.
/// A senha de nível compartilhada (env/AppConfig) segue como mestra de emergência.
/// O hash é sha256 com salt por linha (mesmo padrão do auth-levels.util); a
/// unicidade do PIN é garantida no service (não dá pra impor por índice com salt).
model OperadorPin {
  id        String   @id @default(cuid())
  cpf       String   @unique @db.VarChar(14)
  nome      String   @db.VarChar(120)
  nivel     String   @db.VarChar(20) // CAIXA | SUPERVISOR | GERENTE | MASTER | SUPREMA
  pinSalt   String   @map("pin_salt")
  pinHash   String   @map("pin_hash")
  ativo     Boolean  @default(true)
  // Loja de origem — escopo de visualização (gerente vê só as da sua loja).
  storeCode String?  @map("store_code") @db.VarChar(20)
  // ESCOPO DE VALIDADE do PIN (dono 29/07): CSV de códigos de loja onde o PIN
  // FUNCIONA (ex.: "03,10,17,18" = franqueado MASTER só nas lojas dele).
  // Null/vazio = vale em todas as lojas (comportamento original).
  lojas     String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ativo])
  @@index([storeCode])
  @@map("operador_pin")
}

/// ═══════════════ CONTAS A PAGAR (100% Flow — GIGA congelado) ═══════════════
/// Decisões do dono 11/07/2026 + dossiê docs/GIGA-CONTAS-DESCOBERTA.md.
/// GigaPagar = espelho RAW fiel da tabela `pagar` (só pra migração/conferência
/// do congelamento — NUNCA é fonte de tela). ContaPagar = o modelo novo.

model GigaPagar {
  registro Int      @id // pagar.REGISTRO (PK do GIGA)
  pnum     String?  @db.VarChar(30)
  pesp     String?  @db.VarChar(10)
  pser     String?  @db.VarChar(5)
  pfav     Int?
  pemi     DateTime? @db.Date
  pban     String?  @db.VarChar(20)
  pval     Decimal? @db.Decimal(10, 2)
  pven     DateTime? @db.Date
  paga     DateTime? @db.Date
  pjur     Decimal? @db.Decimal(10, 2)
  pdes     Decimal? @db.Decimal(10, 2)
  pobs     String?  @db.VarChar(50)
  nnota    String?  @db.VarChar(10)
  ncheque  String?  @db.VarChar(12)
  pend     String?  @db.VarChar(3)
  loja     String?  @db.VarChar(2)
  syncedAt DateTime @default(now()) @map("synced_at")

  @@index([loja])
  @@index([pven])
  @@index([pesp])
  @@map("giga_pagar")
}

/// Catálogo de espécies — editável na tela. Semente = 11 do GIGA + as variantes
/// promovidas (CHEQUE, PROMISSORIA, CARNE, SEM ESPECIE) + as novas de
/// funcionárias (SALARIO, COMISSAO). `restrita` = só perfis autorizados veem
/// contas dessa espécie (RH/SALARIO/VALE/COMISSAO — salário é dado sensível).
model EspecieConta {
  id        String   @id @default(cuid())
  nome      String   @unique @db.VarChar(30)
  restrita  Boolean  @default(false)
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  // ── Classificação na DRE (painel /retaguarda/dre) ──
  //   VARIAVEL   = varia com a venda (comissão, taxa de cartão, frete)
  //   FIXA       = fixa da loja (aluguel, folha, luz, contador…)
  //   FINANCEIRA = juros, multa, IOF, encargo de empréstimo
  //   CMV        = compra de MERCADORIA → NÃO entra como despesa. O CMV da
  //                DRE sai do custo das peças VENDIDAS; contar a compra
  //                também seria contar estoque duas vezes.
  //   IMPOSTO    = DAS/Simples → NÃO entra: o imposto vem da alíquota por
  //                CNPJ configurada no painel (regime de competência).
  //   IGNORAR    = transferência entre contas, adiantamento, etc.
  // NULL = o service classifica por heurística no nome e a tela sinaliza.
  dreGrupo  String?  @map("dre_grupo") @db.VarChar(10)

  contas ContaPagar[]

  @@map("especie_conta")
}

/// A conta a pagar do Flow. Migrada do GIGA (gigaRegistro preenchido) ou
/// nascida aqui. Soft delete (deletedAt/deletedBy) — nada some de verdade.
/// Beneficiário: FORNECEDOR (fornecedorGigaCodigo/nome) OU FUNCIONARIA
/// (sellerId/CPF do RH). Parcelas REAIS via grupoParcelaId + parcelaNum/Total.
model ContaPagar {
  id       String @id @default(cuid())
  numero   Int    @unique @default(autoincrement())
  lojaCode String @map("loja_code") @db.VarChar(4)

  beneficiarioTipo    String  @default("fornecedor") @map("beneficiario_tipo") @db.VarChar(12) // fornecedor | funcionaria
  fornecedorGigaCodigo Int?   @map("fornecedor_giga_codigo")
  fornecedorNome      String? @map("fornecedor_nome") @db.VarChar(120)
  sellerId            String? @map("seller_id")
  sellerNome          String? @map("seller_nome") @db.VarChar(120)
  sellerCpf           String? @map("seller_cpf") @db.VarChar(14)

  especieId       String? @map("especie_id")
  especie         EspecieConta? @relation(fields: [especieId], references: [id])
  especieOriginal String? @map("especie_original") @db.VarChar(10) // PESP cru do GIGA

  notaFiscal String? @map("nota_fiscal") @db.VarChar(40)
  banco      String? @db.VarChar(40)
  cheque     String? @db.VarChar(20)
  emissao    DateTime? @db.Date
  vencimento DateTime  @db.Date
  valorCents Int       @map("valor_cents")

  // Baixa (P3 do dono: juros e desconto SÃO preenchidos no pagamento)
  pagamento      DateTime? @db.Date
  jurosCents     Int       @default(0) @map("juros_cents")
  descontoCents  Int       @default(0) @map("desconto_cents")
  pagoPor        String?   @map("pago_por") @db.VarChar(80)

  emMaos         Boolean @default(false) @map("em_maos")
  emMaosOriginal String? @map("em_maos_original") @db.VarChar(3) // PEND cru do GIGA
  observacao     String? @db.VarChar(200)

  parcelaNum     Int?    @map("parcela_num")
  parcelaTotal   Int?    @map("parcela_total")
  grupoParcelaId String? @map("grupo_parcela_id")

  status String @default("aberta") @db.VarChar(12) // aberta | paga | cancelada

  // Migração/qualidade (dossiê §4)
  gigaRegistro    Int?    @unique @map("giga_registro")
  favorecidoOrfao Boolean @default(false) @map("favorecido_orfao")
  dataSuspeita    Boolean @default(false) @map("data_suspeita")

  createdBy String?   @map("created_by") @db.VarChar(80)
  updatedBy String?   @map("updated_by") @db.VarChar(80)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.VarChar(80)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  logs ContaPagarLog[]

  @@index([lojaCode, vencimento])
  @@index([status, vencimento])
  @@index([especieId])
  @@index([sellerId])
  @@index([grupoParcelaId])
  @@index([fornecedorNome])
  @@index([deletedAt])
  @@map("conta_pagar")
}

/// Auditoria POR CAMPO de toda alteração (quem, o quê, antes → depois).
model ContaPagarLog {
  id         String   @id @default(cuid())
  contaId    String   @map("conta_id")
  conta      ContaPagar @relation(fields: [contaId], references: [id])
  campo      String   @db.VarChar(40)
  valorAntigo String? @map("valor_antigo") @db.VarChar(300)
  valorNovo   String? @map("valor_novo") @db.VarChar(300)
  usuario    String?  @db.VarChar(80)
  origem     String   @default("tela") @db.VarChar(20) // tela | migracao | sistema
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([contaId])
  @@index([createdAt])
  @@map("conta_pagar_log")
}

/// Associação Fornecedor(GIGA) → Funcionária (decisão do dono 11/07): os
/// ~440 "fornecedores" que são PESSOAS (folha RH/VALE de 20 anos) viram
/// beneficiário FUNCIONÁRIA nas contas e somem do autocomplete de
/// fornecedores. Persistente (o espelho wincred_fornecedores é truncado a
/// cada sync — flag lá se perderia). naoEhPessoa=true = descartado da
/// conciliação (ex.: CONTABILIDADE). Reversível (desfazer apaga a linha).
model ContaPagarAssociacao {
  id                   String   @id @default(cuid())
  fornecedorGigaCodigo Int      @unique @map("fornecedor_giga_codigo")
  fornecedorNome       String?  @map("fornecedor_nome") @db.VarChar(120)
  sellerId             String?  @map("seller_id")
  sellerNome           String?  @map("seller_nome") @db.VarChar(120)
  naoEhPessoa          Boolean  @default(false) @map("nao_eh_pessoa")
  contasConvertidas    Int      @default(0) @map("contas_convertidas")
  criadoPor            String?  @map("criado_por") @db.VarChar(80)
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([sellerId])
  @@map("conta_pagar_associacao")
}

/// Alíquota efetiva de imposto por CNPJ × mês (painel /retaguarda/dre).
/// O grupo tem VÁRIOS CNPJs e cada um está numa faixa diferente do Simples
/// (a faixa muda com o RBT12) — por isso a alíquota é por CNPJ e por MÊS, não
/// um percentual único da rede. A loja herda pelo `Store.expectedCnpj`.
/// Mês sem linha própria usa a alíquota mais recente ANTERIOR do mesmo CNPJ;
/// CNPJ sem nenhuma linha entra com imposto zero e a tela avisa.
model DreAliquota {
  id          String   @id @default(cuid())
  cnpj        String   @db.VarChar(14)   // só dígitos
  mes         String   @db.VarChar(7)    // YYYY-MM
  aliquotaPct Decimal  @map("aliquota_pct") @db.Decimal(5, 2)
  observacao  String?  @db.VarChar(120)
  criadoPor   String?  @map("criado_por") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([cnpj, mes])
  @@index([cnpj, mes])
  @@map("dre_aliquota")
}

/// Ajuste GERENCIAL da DRE (painel /retaguarda/dre).
///
/// Existe pra corrigir o resultado SEM mexer no Contas a Pagar — o financeiro
/// real continua intocado (a conta da VERISURE segue lá, e segue sendo paga).
/// Dois tipos:
///
///   EXCLUIR_FORNECEDOR — tira da DRE tudo de um fornecedor (ex: VERISURE,
///     contrato encerrado). O valor não some: aparece no bloco "o que ficou
///     de fora" com o motivo.
///
///   DESPESA_FIXA — soma uma despesa que o dono sabe que existe mas que não
///     está lançada no Contas a Pagar (ex: segurança R$ 200/loja). Valor é
///     MENSAL e entra proporcional aos dias do período. `lojasExcluidas`
///     lista quem NÃO paga (ex: SANTOS).
///
///   DESPESA_PCT — despesa que acompanha a venda, em % do FATURAMENTO BRUTO
///     de cada coluna (ex: marketing 5%). Não precisa de rateio nem de
///     proporção por dias: se a loja vendeu mais, gastou mais.
model DreAjuste {
  id        String  @id @default(cuid())
  tipo      String  @db.VarChar(20) // EXCLUIR_FORNECEDOR | DESPESA_FIXA | DESPESA_PCT
  descricao String  @db.VarChar(60) // rótulo que aparece na DRE

  /// DESPESA_PCT: % sobre o faturamento bruto da coluna.
  percentual Decimal? @db.Decimal(6, 3)

  /// EXCLUIR_FORNECEDOR: casa por "contém", sem acento e case-insensitive.
  fornecedorMatch String? @map("fornecedor_match") @db.VarChar(60)

  /// DESPESA_FIXA: valor MENSAL por loja.
  valorMensalCents Int?    @map("valor_mensal_cents")
  grupo            String? @db.VarChar(12) // FIXA | VARIAVEL | FINANCEIRA
  /// Códigos de loja que NÃO pagam, separados por vírgula.
  lojasExcluidas   String? @map("lojas_excluidas") @db.VarChar(200)
  /// Aplica SÓ nestas lojas (se preenchido, `lojasExcluidas` é ignorado).
  /// Ex: marketing do SITE é 20% e o das lojas é 5% — dois ajustes, cada um
  /// mirando o seu alvo, em vez de excluir todo o resto da rede na mão.
  lojasIncluidas   String? @map("lojas_incluidas") @db.VarChar(200)

  ativo     Boolean  @default(true)
  criadoPor String?  @map("criado_por") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  realizados DreAjusteRealizado[]

  @@index([tipo, ativo])
  @@map("dre_ajuste")
}

/// Taxa da adquirente por BANDEIRA × FAIXA DE PARCELA (dono, 26/07).
///
/// A DRE cruza isto com os pagamentos reais da venda (`PdvSalePayment`, que
/// guarda bandeira e nº de parcelas em `details`) e joga o resultado em
/// DESPESA VARIÁVEL — sem depender de ninguém lançar no Contas a Pagar.
///
/// Taxa vale pra rede toda (decisão do dono: as maquininhas são negociadas
/// junto). `faixaParcela`: UNICA (pix/débito) | 1 | 2-6 | 7-12.
model TaxaCartao {
  id           String  @id @default(cuid())
  forma        String  @db.VarChar(10) // PIX | DEBITO | CREDITO
  bandeira     String  @db.VarChar(20) // VISA, MASTERCARD, ELO, AMEX…
  faixaParcela String  @map("faixa_parcela") @db.VarChar(6)
  /// % sobre o valor pago. 3 casas: adquirente cobra 2,49%, 3,199%…
  taxaPct      Decimal @map("taxa_pct") @db.Decimal(6, 3)
  ativo        Boolean @default(true)

  criadoPor String?  @map("criado_por") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([bandeira, faixaParcela])
  @@index([ativo])
  @@map("taxa_cartao")
}

/// VALOR REALIZADO de um ajuste percentual, por MÊS (dono, 26/07).
///
/// O percentual do `DreAjuste` é uma SIMULAÇÃO — serve pro mês corrente, antes
/// de fechar a fatura da mídia. Quando o dono lança aqui o que gastou de
/// verdade, este valor SOBREPÕE o percentual naquele mês, e a DRE para de
/// simular. Enquanto não houver linha, vale o coeficiente.
///
/// O valor é o TOTAL do mês; a DRE distribui entre as colunas-alvo do ajuste
/// proporcional ao faturamento de cada uma (mesmo critério do percentual).
model DreAjusteRealizado {
  id       String @id @default(cuid())
  ajusteId String @map("ajuste_id")
  mes      String @db.VarChar(7) // YYYY-MM

  valorCents Int    @map("valor_cents")
  observacao String? @db.VarChar(160)

  lancadoPor String?  @map("lancado_por") @db.VarChar(80)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  ajuste DreAjuste @relation(fields: [ajusteId], references: [id], onDelete: Cascade)

  @@unique([ajusteId, mes])
  @@index([mes])
  @@map("dre_ajuste_realizado")
}



/// DEMANDAS (15/07): backlog do dono na aba Gestao - prompt + prints colados,
/// criticidade em 3 niveis e datas de criacao/finalizacao. So admin.
model Demanda {
  id          String    @id @default(uuid())
  titulo      String?   @db.VarChar(120)
  prompt      String
  criticidade String    @db.VarChar(12)
  status      String    @default("aberta")
  createdAt   DateTime  @default(now()) @map("created_at")
  finishedAt  DateTime? @map("finished_at")
  userName    String?   @map("user_name") @db.VarChar(60)
  tags        String[]  @default([])
  imagens     DemandaImagem[]

  @@index([status, criticidade])
  @@map("demandas")
}

model DemandaImagem {
  id        String   @id @default(uuid())
  demandaId String   @map("demanda_id")
  demanda   Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  mime      String   @db.VarChar(40)
  dataB64   String   @map("data_b64")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([demandaId])
  @@map("demanda_imagens")
}

/// Tags das demandas (17/07): catalogo criado pelo dono (RH, CONTAS A PAGAR,
/// PDV...). A demanda guarda os nomes em array (filtro via has).
model DemandaTag {
  id        String   @id @default(uuid())
  nome      String   @unique @db.VarChar(30)
  cor       String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("demanda_tags")
}

/// ═══════════ CONCILIACAO FINANCEIRA (aprovado 17/07) ═══════════
/// Espinha do modulo: toda transacao de gateway (PagBank/Pagarme/Stone) vira
/// uma linha aqui, com o JSON BRUTO guardado (nunca perder informacao).
model FinancialTransaction {
  id                String    @id @default(uuid())
  gateway           String    @db.VarChar(12)
  origem            String?   @db.VarChar(10)
  pedidoRef         String?   @map("pedido_ref") @db.VarChar(40)
  storeCode         String?   @map("store_code") @db.VarChar(4)
  paymentId         String?   @map("payment_id") @db.VarChar(80)
  chargeId          String?   @map("charge_id") @db.VarChar(80)
  transactionId     String?   @map("transaction_id") @db.VarChar(80)
  authorizationCode String?   @map("authorization_code") @db.VarChar(40)
  nsu               String?   @db.VarChar(40)
  tid               String?   @db.VarChar(40)
  pixTxid           String?   @map("pix_txid") @db.VarChar(80)
  statusGateway     String?   @map("status_gateway") @db.VarChar(30)
  statusInterno     String    @default("pendente") @map("status_interno") @db.VarChar(20)
  valorBrutoCents   Int?      @map("valor_bruto_cents")
  valorLiquidoCents Int?      @map("valor_liquido_cents")
  taxaCents         Int?      @map("taxa_cents")
  parcelas          Int?
  bandeira          String?   @db.VarChar(20)
  tipoPagamento     String?   @map("tipo_pagamento") @db.VarChar(20)
  cartaoFinal       String?   @map("cartao_final") @db.VarChar(4)
  dataVenda         DateTime? @map("data_venda")
  dataAutorizacao   DateTime? @map("data_autorizacao")
  dataCaptura       DateTime? @map("data_captura")
  dataCancelamento  DateTime? @map("data_cancelamento")
  dataRecebimento   DateTime? @map("data_recebimento")
  rawJson           Json?     @map("raw_json")
  rawHash           String?   @map("raw_hash") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([gateway, chargeId, transactionId])
  @@index([gateway, dataVenda])
  @@index([pedidoRef])
  @@index([nsu])
  @@index([pixTxid])
  @@index([statusInterno])
  @@map("financial_transactions")
}

/// Creditos efetivamente pagos pela adquirente (extrato/recebiveis).
model FinancialRecebimento {
  id            String    @id @default(uuid())
  gateway       String    @db.VarChar(12)
  transactionId String?   @map("transaction_id") @db.VarChar(80)
  chargeId      String?   @map("charge_id") @db.VarChar(80)
  dataCredito   DateTime? @map("data_credito")
  valorCents    Int?      @map("valor_cents")
  taxaCents     Int?      @map("taxa_cents")
  liquidoCents  Int?      @map("liquido_cents")
  lote          String?   @db.VarChar(40)
  banco         String?   @db.VarChar(40)
  status        String?   @db.VarChar(20)
  rawJson       Json?     @map("raw_json")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([gateway, dataCredito])
  @@index([transactionId])
  @@map("financial_recebimentos")
}

/// Resultado do motor: cada transacao casada (ou nao) com venda e recebimento.
model FinancialConciliacao {
  id               String    @id @default(uuid())
  transactionId    String    @unique @map("transaction_id")
  pedidoRef        String?   @map("pedido_ref") @db.VarChar(40)
  gateway          String    @db.VarChar(12)
  status           String    @db.VarChar(20)
  valorSistemaCents  Int?    @map("valor_sistema_cents")
  valorGatewayCents  Int?    @map("valor_gateway_cents")
  valorRecebidoCents Int?    @map("valor_recebido_cents")
  diferencaCents     Int?    @map("diferenca_cents")
  motivo           String?   @db.VarChar(200)
  ultimaConciliacao DateTime @default(now()) @map("ultima_conciliacao")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([gateway, status])
  @@map("financial_conciliacoes")
}

// ═══════════════════════════════════════════════════════════════════════
// PORTAL DE TROCAS — self-service do e-commerce (cliente solicita sozinha)
// ═══════════════════════════════════════════════════════════════════════
//
// Diferente do WcReturnRequest (troca registrada PELA EQUIPE quando a peça
// já está na loja), aqui a SOLICITAÇÃO nasce no portal público /trocas e
// atravessa um fluxo com status até a conclusão. O valor usado em qualquer
// vale/reembolso é o LÍQUIDO PAGO pela cliente (congelado no momento da
// solicitação — mudança de preço futura não afeta).
//
// Encadeamento (troca da troca): parentId aponta pra troca de origem;
// wcOrderId SEMPRE aponta pro pedido original (nunca se perde o vínculo).

model TrocaSolicitacao {
  id            String   @id @default(uuid())
  // Numeração sequencial exibida como T0001, T0002...
  numero        Int      @unique @default(autoincrement())
  // Pedido WC original (raiz do encadeamento)
  wcOrderId     Int      @map("wc_order_id")
  wcOrderNumber String?  @map("wc_order_number")
  // Troca de origem (quando é troca da troca)
  parentId      String?  @map("parent_id")
  parent        TrocaSolicitacao?  @relation("TrocaEncadeada", fields: [parentId], references: [id])
  filhas        TrocaSolicitacao[] @relation("TrocaEncadeada")
  // Cliente (snapshot do pedido)
  customerName  String?  @map("customer_name")
  customerCpf   String?  @map("customer_cpf")
  customerEmail String?  @map("customer_email")
  customerPhone String?  @map("customer_phone")
  // Motivo
  motivo        String
  motivoDetalhe String?  @map("motivo_detalhe") @db.Text
  // Fluxo: solicitada | aguardando_postagem | aguardando_envio_cliente |
  //   postada | em_transporte | recebida | em_conferencia |
  //   aguardando_decisao | produto_reservado | aguardando_pagamento_diferenca |
  //   reembolso_andamento | finalizada | cancelada
  status        String   @default("solicitada")
  // Validação do prazo (snapshot na solicitação)
  trackingCodePedido String?   @map("tracking_code_pedido")
  deliveredAt        DateTime? @map("delivered_at")
  // 'rastreio' (entrega detectada) | 'data_pedido' (fallback) | 'nao_verificado'
  prazoVerificadoVia String?   @map("prazo_verificado_via")
  diasDesdeEntrega   Int?      @map("dias_desde_entrega")
  dentroDoPrazo      Boolean?  @map("dentro_do_prazo")
  // Declaração da cliente (checkboxes obrigatórios do portal)
  declaracaoAceitaAt DateTime? @map("declaracao_aceita_at")
  declaracaoIp       String?   @map("declaracao_ip")
  // Logística reversa
  reversaGratis    Boolean   @default(false) @map("reversa_gratis")
  reversaCodigo    String?   @map("reversa_codigo")
  reversaPrazo     DateTime? @map("reversa_prazo")
  reversaEnviadaAt DateTime? @map("reversa_enviada_at")
  // Lembrete de vencimento do código reverso (cron manda 1x)
  reversaLembreteAt DateTime? @map("reversa_lembrete_at")
  // Devolução por conta da cliente (benefício já usado): rastreio informado
  clienteTrackingCode String? @map("cliente_tracking_code")
  // Soma do líquido pago dos itens selecionados
  valorTotalPago Float    @map("valor_total_pago")

  // ── FASE 2: recebimento → conferência → decisão → envio ──
  recebidaAt         DateTime? @map("recebida_at")
  conferenciaAt      DateTime? @map("conferencia_at")
  conferenciaAprovada Boolean? @map("conferencia_aprovada")
  conferenciaChecklist Json?   @map("conferencia_checklist")
  conferenciaReprovadaMotivo String? @map("conferencia_reprovada_motivo")
  // Loja que recebeu a peça fisicamente (entrada de estoque nela)
  receivingStoreCode String?   @map("receiving_store_code")
  receivingStoreName String?   @map("receiving_store_name")
  // Decisão da cliente: trocar_tamanho | trocar_cor | vale | reembolso
  decisao            String?
  decisaoAt          DateTime? @map("decisao_at")
  // Nova peça escolhida (reserva LÓGICA — desconta da disponibilidade
  // mostrada a outras trocas; Giga só baixa no envio real)
  novaSku            String?   @map("nova_sku")
  novaProductName    String?   @map("nova_product_name")
  novaCor            String?   @map("nova_cor")
  novaTamanho        String?   @map("nova_tamanho")
  reservaAt          DateTime? @map("reserva_at")
  // Vale-compras (cupom WC + registro local, 90 dias)
  valeCode           String?   @unique @map("vale_code")
  valeValidade       DateTime? @map("vale_validade")
  // Reembolso (sistema ORGANIZA; equipe executa no gateway)
  reembolsoForma     String?   @map("reembolso_forma")     // pix | cartao | outro
  reembolsoChavePix  String?   @map("reembolso_chave_pix")
  reembolsoConcluidoAt DateTime? @map("reembolso_concluido_at")
  // Envio da nova peça
  envioTrackingCode  String?   @map("envio_tracking_code")
  envioAt            DateTime? @map("envio_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  items   TrocaItem[]
  eventos TrocaEvento[]

  @@index([wcOrderId])
  @@index([customerCpf])
  @@index([status, createdAt(sort: Desc)])
  @@map("troca_solicitacoes")
}

model TrocaItem {
  id          String  @id @default(uuid())
  trocaId     String  @map("troca_id")
  sku         String
  productName String? @map("product_name")
  qty         Int     @default(1)
  // Preço cheio unitário (subtotal do WC, antes de qualquer desconto)
  valorOriginalUnit Float @map("valor_original_unit")
  // LÍQUIDO pago unitário (promoção + cupom rateado + desconto PIX rateado)
  valorPagoUnit     Float @map("valor_pago_unit")
  totalPago         Float @map("total_pago")
  // Entrada de estoque na conferência aprovada (via increaseStock)
  stockReturnedAt   DateTime? @map("stock_returned_at")
  stockError        String?   @map("stock_error")
  createdAt   DateTime @default(now()) @map("created_at")

  troca TrocaSolicitacao @relation(fields: [trocaId], references: [id], onDelete: Cascade)

  @@index([trocaId])
  @@index([sku])
  @@map("troca_itens")
}

// Linha do tempo auditável — nunca apagar (regra da política)
model TrocaEvento {
  id         String   @id @default(uuid())
  trocaId    String   @map("troca_id")
  tipo       String   // solicitacao | status | reversa | rastreio_cliente | concessao | email | nota
  descricao  String   @db.Text
  statusDe   String?  @map("status_de")
  statusPara String?  @map("status_para")
  userId     String?  @map("user_id")
  userName   String?  @map("user_name")
  createdAt  DateTime @default(now()) @map("created_at")

  troca TrocaSolicitacao @relation(fields: [trocaId], references: [id], onDelete: Cascade)

  @@index([trocaId, createdAt])
  @@map("troca_eventos")
}

// Concessão EXTRA de reversa grátis (além da 1 por CPF) — exige justificativa
model TrocaReversaConcessao {
  id            String   @id @default(uuid())
  cpf           String
  trocaId       String?  @map("troca_id")
  justificativa String   @db.Text
  userId        String?  @map("user_id")
  userName      String?  @map("user_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([cpf])
  @@map("troca_reversa_concessoes")
}

// ═══════════════════════════════════════════════════════════════════════════
// LURDS FIT AI — recomendação proprietária de tamanho
//
// Camada 100% da Lurd's (nada de terceiro). Fica SEPARADA de `Product` de
// propósito: `Product` é espelho do Giga e é sobrescrito a cada sync — o que
// a gente cadastra aqui (modelagem, elastano, caimento) nunca seria
// preservado lá. Chave é a REF (a peça), não o código de cor/tamanho.
// ═══════════════════════════════════════════════════════════════════════════

/// Ficha de CAIMENTO da peça — o que o algoritmo precisa saber do produto.
model FitProduct {
  ref         String   @id @db.VarChar(20)   // REF normalizada (upper, sem espaço)
  categoria   String?  @db.VarChar(20)       // vestido|blusa|calca|legging|jaqueta|camisa|saia|macacao
  marca       String?  @db.VarChar(30)
  fornecedor  String?  @db.VarChar(40)
  modelagem   String?  @db.VarChar(10)       // pequena | normal | grande
  elastano    String?  @db.VarChar(10)       // sem | pouco | muito
  caimento    String?  @db.VarChar(10)       // justo | normal | amplo
  composicao  String?  @db.VarChar(120)      // "95% viscose, 5% elastano"
  /// Medidas REAIS da peça por tamanho: { "54": { busto: 118, cintura: 104, quadril: 126, comprimento: 92 } }
  medidas     Json?
  observacao  String?  @db.Text

  atualizadoPor String? @map("atualizado_por") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([categoria])
  @@index([marca])
  @@map("fit_product")
}

/// BODY PROFILE da cliente — nasce no widget, vive no CRM.
model FitBodyProfile {
  id          String   @id @default(uuid())
  /// Liga no CRM quando a cliente é conhecida (telefone/CPF informado depois)
  customerId  String?  @map("customer_id")
  /// Identificador anônimo do navegador (localStorage) até virar cliente
  anonId      String?  @map("anon_id") @db.VarChar(40)

  alturaCm    Int      @map("altura_cm")
  pesoKg      Int      @map("peso_kg")
  idade       Int?
  preferencia String   @db.VarChar(10)       // justa | normal | soltinha
  formatoCorpo String? @map("formato_corpo") @db.VarChar(12) // ampulheta|pera|maca|retangulo|naosei
  busto       String?  @db.VarChar(1)        // P | M | G
  quadril     String?  @db.VarChar(1)        // P | M | G
  tamanhoHabitual String? @map("tamanho_habitual") @db.VarChar(4)

  ultimoRecomendado String? @map("ultimo_recomendado") @db.VarChar(4)
  ultimoComprado    String? @map("ultimo_comprado") @db.VarChar(4)
  ultimoTrocado     String? @map("ultimo_trocado") @db.VarChar(4)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recomendacoes FitRecommendation[]

  @@index([customerId])
  @@index([anonId])
  @@map("fit_body_profile")
}

/// Cada recomendação entregue — é o dataset de treino do sistema.
model FitRecommendation {
  id          String   @id @default(uuid())
  profileId   String?  @map("profile_id")
  customerId  String?  @map("customer_id")
  anonId      String?  @map("anon_id") @db.VarChar(40)

  ref         String?  @db.VarChar(20)
  categoria   String?  @db.VarChar(20)
  marca       String?  @db.VarChar(30)
  /// Snapshot do que a cliente respondeu + o que a peça informava
  entrada     Json
  /// Passo a passo do cálculo (auditoria: por que deu 54)
  trilha      Json?

  tamanho       String  @db.VarChar(4)
  tamanhoAlt    String? @map("tamanho_alt") @db.VarChar(4)
  confianca     Int
  origem        String  @default("pdp") @db.VarChar(20)  // pdp | live | whatsapp | pdv

  /// Fechamento do ciclo (alimenta o aprendizado)
  desfecho        String?   @db.VarChar(12)  // comprou | trocou | devolveu | ignorou
  tamanhoComprado String?   @map("tamanho_comprado") @db.VarChar(4)
  tamanhoFinal    String?   @map("tamanho_final") @db.VarChar(4)
  desfechoAt      DateTime? @map("desfecho_at")

  createdAt   DateTime @default(now()) @map("created_at")

  profile FitBodyProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([ref])
  @@index([customerId])
  @@index([createdAt])
  @@index([desfecho])
  @@map("fit_recommendation")
}

/// MODELO APRENDIDO — viés de tamanho por escopo (a "IA" treinada nas vendas
/// reais da Lurd's). Ex.: escopo='ref' chave='12345' viesMedio=+0.8 → essa
/// peça veste pequeno, recomenda um número acima.
model FitStat {
  id        String   @id @default(uuid())
  escopo    String   @db.VarChar(12)   // ref | categoria | marca | modelagem | fornecedor
  chave     String   @db.VarChar(40)

  amostras  Int      @default(0)       // quantos desfechos alimentaram
  viesSoma  Float    @default(0) @map("vies_soma")   // Σ (passos de correção)
  viesMedio Float    @default(0) @map("vies_medio")
  acertos   Int      @default(0)       // comprou e ficou
  trocas    Int      @default(0)
  devolucoes Int     @default(0)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([escopo, chave])
  @@index([escopo])
  @@map("fit_stat")
}

// ═══════════════════════════════════════════════════════════════════════════
// CATÁLOGO DO E-COMMERCE (sprint 008 — ERP como fonte da verdade)
//
// Divisão de responsabilidade, decidida pelo que cada sistema REALMENTE tem:
//   ERP (wincred_produtos/estoque) → código, REF, EAN, grade, cor, tamanho,
//        marca, preço, custo, NCM, estoque por loja. É a VERDADE.
//   Flow (site_produto)            → nome comercial, descrição, SEO, coleção,
//        curadoria. É o CADASTRO, não cache: decisão do dono 30/07 — "criar
//        os campos faltantes no Flow, 100% de integração site ↔ CRM".
//   Flow (product_photos, R2)      → fotos por REF+cor (já existia, usada na Live).
//   WooCommerce                    → APENAS origem de IMPORTAÇÃO enquanto o
//        site antigo viver. Assim que alguém edita a peça no Flow, ela vira
//        origemConteudo='flow' e o importador nunca mais a sobrescreve.
//   FitProduct (Flow)              → modelagem, elastano, caimento, medidas.
//
// `SiteProduto` é CACHE + CURADORIA: 1 linha por REF publicada. Não duplica
// dado do ERP (preço/estoque saem sempre do espelho na hora da consulta).
// ═══════════════════════════════════════════════════════════════════════════

model SiteProduto {
  ref               String   @id @db.VarChar(20)
  slug              String   @unique @db.VarChar(160)
  nome              String   @db.VarChar(160)
  descricaoCurta    String?  @map("descricao_curta") @db.Text
  descricaoCompleta String?  @map("descricao_completa") @db.Text

  /// Mídia do WC: [{ src, alt, tipo: 'imagem'|'video'|'360' }]
  imagens           Json?
  /// SEO importado: { metaTitle, metaDescription, canonical, ogImage }
  seo               Json?

  /// Cadastro comercial (não existe no ERP)
  /// Categoria COMERCIAL do site (vestidos, blusas, calcas…). Não é o grupo
  /// do Giga: `nomeGrupo` é classificação fiscal/interna, quase sempre vazia
  /// e com valor tipo "BLUSA FEMININA" — nunca casaria com o menu do site.
  categoria         String?  @db.VarChar(30)
  colecao           String?  @db.VarChar(60)
  linha             String?  @db.VarChar(60)

  /// MESMA PEÇA, CORES EM REFs DIFERENTES — o agrupamento do catálogo legado.
  ///
  /// No site antigo a cor era resolvida INVENTANDO REF: `900887` era a preta e
  /// `900887B` a bege — mesma peça, dois cadastros. Resultado na vitrine: dois
  /// cards idênticos lado a lado, e a cliente escolhendo entre o que parece
  /// ser o mesmo produto duas vezes (achado do dono em 10/08/2026).
  ///
  /// Este campo diz "estas REFs são um produto só". A listagem agrupa por
  /// `grupoRef ?? ref`, e as cores de todas elas viram as bolinhas de uma
  /// peça. `null` = peça sozinha, que é o caso normal.
  ///
  /// Preenchido pelo sync a partir da RAIZ NUMÉRICA da REF (`900887B` →
  /// `900887`), mas só quando as candidatas concordam em categoria e preço —
  /// agrupar errado junta produtos diferentes num card e faz a cliente comprar
  /// a peça errada, o que é pior que deixar separado.
  ///
  /// `grupoRefManual` trava a decisão de quem revisou: o sync NUNCA sobrescreve
  /// um grupo marcado à mão, senão a correção se perderia toda madrugada.
  /// A REF nova (gerada pela `EanSequence`) já nasce com cor resolvida dentro
  /// da própria peça — este campo é dívida do catálogo legado, não desenho.
  grupoRef          String?  @map("grupo_ref") @db.VarChar(20)
  grupoRefManual    Boolean  @default(false) @map("grupo_ref_manual")

  /// SUBCATEGORIA do site — o segundo nível abaixo de `categoria`.
  ///
  /// "Blusas" é a categoria; "Manga curta" a subcategoria (dono, 10/08/2026).
  /// Guarda o SLUG da `SiteCategoria` filha (`manga-curta`), e é ela que
  /// aparece como filtro dentro da página da categoria.
  ///
  /// ⚠️ NÃO é o grupo/subgrupo do Giga. Aquilo é classificação FISCAL
  /// ("BLUSA FEMININA", "VESTIDO MID"), vive num espelho que é recriado por
  /// TRUNCATE a cada sync, e estava preenchido em 3% do catálogo. Decisão do
  /// dono no mesmo dia: **esquecer o Giga** — a taxonomia da vitrine nasce e
  /// vive no Flow, com nome que a cliente entende.
  subcategoria      String?  @db.VarChar(40)
  /// Quem classificou e quando — classificar 797 peças é trabalho manual caro,
  /// e saber o que já foi feito evita refazer.
  classificadoPor   String?  @map("classificado_por")
  classificadoEm    DateTime? @map("classificado_em")

  /// PREÇO PROMOCIONAL SÓ DO SITE (dono, 14/08/2026).
  ///
  /// O preço normal vem do ERP (`wincred_produtos.vendaUn`), que é o MESMO do
  /// PDV das 14 lojas — baixar lá baixaria no caixa físico também. Este campo
  /// é o override que vale SÓ no site: quando preenchido, a vitrine, a PDP e o
  /// checkout usam ele no lugar do preço do ERP. `precoDe` é o "de" riscado
  /// (a âncora do criativo). Nulo = sem promoção, preço normal do ERP.
  ///
  /// ⚠️ A trava antifraude do checkout (`CarrinhoGuardService`) TAMBÉM lê este
  /// campo — senão recusaria o pedido com preço menor que o do ERP como
  /// suspeita de fraude. Quem seta `precoPromo` está definindo o preço que a
  /// loja REALMENTE cobra no site; é decisão comercial, não pode nascer errado.
  precoPromo        Float?   @map("preco_promo")
  precoDe           Float?   @map("preco_de")

  /// Curadoria: o que a loja escolheu publicar
  publicado         Boolean  @default(true)
  destaque          Boolean  @default(false)
  /// ⚠️ APOSENTADA (13/08): era a tag "Novidade" herdada do WooCommerce —
  /// etiqueta editorial do site velho que nunca expirava. "Novidades" agora
  /// é AUTOMÁTICO por `publicadoEm` (peça publicada há ≤30 dias). A coluna
  /// fica pra histórico; ninguém mais escreve nem lê.
  lancamento        Boolean  @default(false)
  promocao          Boolean  @default(false)
  /// QUANDO A PEÇA ENTROU NO AR (primeira publicação) — decisão do dono
  /// 13/08: "Novidades" deixa de ser tag herdada e vira idade real. Carimbo
  /// preenchido pela varredura do catálogo (idempotente: só onde está nulo,
  /// backfill = primeira foto R2 da REF, senão syncedAt congelado). Nulo =
  /// nunca publicada (ou despublicada antes do carimbo existir).
  publicadoEm       DateTime? @map("publicado_em")

  /// TOMADA DE POSSE: 'woocommerce' = ainda espelha o site antigo; 'flow' =
  /// alguém editou aqui e o Flow virou dono — o importador PULA essa peça
  /// pra sempre. É o que permite migrar produto a produto, sem big-bang.
  origemConteudo    String   @default("woocommerce") @map("origem_conteudo") @db.VarChar(20)
  editadoPor        String?  @map("editado_por") @db.VarChar(80)
  editadoEm         DateTime? @map("editado_em")

  /// Rastreio de onde veio (nunca inventar vínculo)
  wcId              Int?     @map("wc_id")
  wcSlug            String?  @map("wc_slug") @db.VarChar(160)

  syncedAt          DateTime @default(now()) @map("synced_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([publicado])
  @@index([categoria])
  @@index([destaque])
  @@index([lancamento])
  /// A listagem agrupa por aqui — ver `grupoRef`.
  @@index([grupoRef])
  /// A tela de classificação filtra por "sem subcategoria" e a página da
  /// categoria filtra por ela — sem índice, varreria as 797 peças a cada
  /// troca de filtro.
  @@index([subcategoria])
  @@map("site_produto")
}

/// LOG de cada rodada de sincronização — exigência do sprint 008 (auditoria).
model SiteSyncLog {
  id            String   @id @default(uuid())
  tipo          String   @db.VarChar(20)   // conteudo | validacao
  iniciadoEm    DateTime @default(now()) @map("iniciado_em")
  duracaoMs     Int?     @map("duracao_ms")

  lidos         Int      @default(0)
  criados       Int      @default(0)
  atualizados   Int      @default(0)
  ignorados     Int      @default(0)
  falhas        Int      @default(0)

  /// Detalhe legível: o que foi ignorado e por quê, conflitos, divergências
  detalhes      Json?
  erro          String?  @db.Text
  disparadoPor  String?  @map("disparado_por") @db.VarChar(80)

  @@index([tipo, iniciadoEm])
  @@map("site_sync_log")
}

// ===========================================================================
// CASHBACK DA REDE — chave é o CPF (a PESSOA), não o cadastro
// ===========================================================================
//
// Regra do dono (01/08/2026):
//   · 10% na PRIMEIRA compra da pessoa, 3% nas seguintes
//   · libera no 5º dia e vale por 30 dias a partir daí
//   · vale na rede inteira + site + live (cadastro único por CPF)
//   · paga no máximo 30% de uma compra
//   · devolveu a peça, perde o cashback dela — e pode ficar NEGATIVA
//   · crediário/marcado credita conforme a parcela é PAGA, não no fechamento
//   · SEM acerto entre lojas "por enquanto" — mas o dado de quem gerou e quem
//     usou é gravado desde o primeiro dia, senão não dá pra reconstruir depois
//
// ── POR QUE TABELA NOVA, E NÃO UMA DAS TRÊS QUE JÁ EXISTEM ──
//
// Medição de 01/08 (`scripts/giga-etl/medir-cashback-existente.js`):
//   · cashback_balances/cashback_transactions → chave Customer.id, que é o
//     cadastro POR LOJA. A mesma pessoa tem N deles. Saldo: R$ 131 em 3 fichas,
//     tudo crédito manual de admin. Chave errada pra regra da rede.
//   · customer_accounts.cashback_balance_cents → chave certa (pessoa), mas só
//     existe pra quem instalou o app: 13 contas, R$ 20 de saldo.
// Nenhuma das duas serve, e adaptar qualquer uma quebraria o que já usa. As
// duas ficam de pé (o saldo de R$ 151 é dívida com cliente, não se apaga).
// Unificar o app pra ler DESTE motor é o passo seguinte, e é barato: são R$ 20.

/// Um crédito ganho. `valor` pode ser NEGATIVO: é assim que a devolução cobra
/// de volta um cashback já gasto (o saldo fica devendo e o próximo ganho abate).
model CashbackCredito {
  id             String   @id @default(uuid())
  /// Só dígitos. É a chave da PESSOA — a mesma em qualquer loja ou no site.
  cpf            String   @db.VarChar(11)
  /// Ficha que originou, só pra rastreio. NÃO é chave de nada.
  customerId     String?  @map("customer_id")
  /// 'venda' | 'crediario_parcela' | 'estorno_devolucao' | 'ajuste'
  origem         String   @db.VarChar(24)
  saleId         String?  @map("sale_id")
  parcelaId      String?  @map("parcela_id")
  returnId       String?  @map("return_id")
  /// Loja que GEROU. Guardado pro acerto que o dono ainda não quis ligar.
  storeCode      String   @map("store_code") @db.VarChar(4)
  percentual     Float    @default(0)
  base           Float    @default(0)
  valor          Float
  /// Quanto desse crédito já foi gasto.
  usado          Float    @default(0)
  /// Quanto foi cancelado por devolução da venda que o gerou.
  cancelado      Float    @default(0)
  /// D+5: antes disso o saldo aparece como "a liberar" e não pode ser usado.
  liberaEm       DateTime @map("libera_em")
  /// D+35: depois disso vira pó. Estorno negativo NÃO expira (senão a dívida
  /// sumiria sozinha e a brecha da devolução voltaria a valer).
  expiraEm       DateTime @map("expira_em")
  primeiraCompra Boolean  @default(false) @map("primeira_compra")
  isTraining     Boolean  @default(false) @map("is_training")
  createdAt      DateTime @default(now()) @map("created_at")

  usos           CashbackUso[]

  /// Idempotência: a mesma venda não credita duas vezes, mesmo se o finalize
  /// rodar de novo. (NULLs no Postgres não colidem — vale pra cada origem.)
  @@unique([origem, saleId, parcelaId], name: "cashback_credito_origem_unico")
  @@index([cpf, liberaEm])
  @@index([expiraEm])
  @@index([storeCode, createdAt])
  @@map("cashback_creditos")
}

/// Um resgate. Uma venda pode gerar VÁRIAS linhas: o saldo é consumido em FIFO
/// pelo que vence primeiro, e cada linha aponta pro crédito (logo, pra loja)
/// que bancou aquele pedaço. É esse detalhe que torna o acerto possível depois.
model CashbackUso {
  id          String    @id @default(uuid())
  cpf         String    @db.VarChar(11)
  creditoId   String    @map("credito_id")
  credito     CashbackCredito @relation(fields: [creditoId], references: [id], onDelete: Cascade)
  saleId      String    @map("sale_id")
  /// Loja que USOU (deu o desconto). Hoje absorve sozinha, por decisão do dono.
  storeCode   String    @map("store_code") @db.VarChar(4)
  valor       Float
  estornadoEm DateTime? @map("estornado_em")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([cpf, createdAt])
  @@index([saleId])
  @@index([storeCode, createdAt])
  @@map("cashback_usos")
}

/// ÚLTIMO ACESSO POR TELA — a resposta pra "que telas ninguém usa?".
///
/// Pedido do dono em 11/08/2026, ao planejar a reorganização dos módulos:
/// são 223 rotas no CRM e nenhum registro de uso — nem aqui, nem na Vercel
/// (Web Analytics nunca foi ligado). Sem isso, decidir que tela morre é
/// achismo.
///
/// UMA LINHA POR ROTA, não uma por acesso: a pergunta é "quando foi a última
/// vez e quantas vezes", não auditoria de navegação. Rota dinâmica entra
/// normalizada (/pedidos/[id]) — senão cada pedido viraria uma linha.
model PageAccess {
  /// Rota normalizada: /retaguarda/clientes, /pedidos/[id]...
  path      String   @id @db.VarChar(160)
  hits      Int      @default(0)
  lastAt    DateTime @map("last_at")
  /// Papel de quem acessou por último (admin/store) — diz QUEM usa a tela.
  lastRole  String?  @map("last_role") @db.VarChar(20)
  lastStore String?  @map("last_store") @db.VarChar(10)

  @@index([lastAt])
  @@map("page_access")
}

///
/// CLIQUE NOS BOTÕES DA LOJA — "Como chegar", WhatsApp, Instagram, telefone.
///
/// Pedido do dono em 13/08/2026: saber, loja por loja, quantas pessoas pediram
/// rota ou chamaram no WhatsApp. A página /lojas nasceu sem instrumentação
/// nenhuma (nem GA4) — o botão mais valioso da rede era o único sem medida.
///
/// UMA LINHA POR CLIQUE, ao contrário da `PageAccess` acima. Lá a pergunta era
/// "quando foi a última vez"; aqui é "quantos foram na semana passada, em
/// Suzano, no WhatsApp" — e isso exige recorte por período, que um contador
/// acumulado não devolve. Volume é baixo (dezenas por dia), então cabe.
///
/// O dado é ANÔNIMO de propósito: não guarda IP, nem telefone, nem nada que
/// identifique a pessoa. Quem quiser saber QUEM chamou tem que olhar a
/// conversa no WhatsApp — não é este o lugar.
model SiteStoreClick {
  id        String   @id @default(uuid())
  /// Nome no dialeto GA4: whatsapp_click, instagram_click, store_locator, phone_click.
  evento    String   @db.VarChar(40)
  /// Unidade ("Suzano", "Piracicaba"). Nulo quando o botão não é de uma loja
  /// específica — o WhatsApp geral do rodapé, por exemplo.
  loja      String?  @db.VarChar(80)
  cidade    String?  @db.VarChar(80)
  /// Onde o botão estava: store_card, store_drawer, hero, final_cta. Diz se a
  /// pessoa clicou na lista ou só depois de abrir a ficha da loja.
  origem    String?  @db.VarChar(40)
  path      String?  @db.VarChar(160)
  /// Sessão anônima do tracking. Separa "10 cliques de 1 pessoa indecisa" de
  /// "10 pessoas" — sem ela o número infla e ninguém percebe.
  sessionId String?  @map("session_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([loja, evento, createdAt])
  @@map("site_store_clicks")
}

/// CÓPIA DE PRIMEIRA PARTE DE TODO EVENTO DO SITE (dono, 13/08: "preciso de
/// todos os cliques registrados — para todo o site"). Diferente do
/// SiteStoreClick (só os 4 botões de loja), aqui entra o funil inteiro:
/// view_item, add_to_cart, search, begin_checkout… — SEMPRE, com ou sem o
/// aceite do banner. Sem aceite o evento chega ANONIMIZADO na origem (sem
/// user_id; fbp/fbc nem saem do navegador) — interesse legítimo de medir o
/// próprio site, sem cruzar com terceiro. GA4/Meta continuam atrás do opt-in.
/// Volume é de milhares/dia: quando pesar, a limpeza é por `criadoEm`.
model SiteEvento {
  id        String   @id @default(uuid())
  /// Nome canônico do tracking: view_item, add_to_cart, search…
  evento    String   @db.VarChar(40)
  path      String?  @db.VarChar(200)
  /// Unidade envolvida (botão de loja ou loja atribuída por CEP).
  loja      String?  @db.VarChar(80)
  /// Sessão anônima — separa cliques de pessoas. Nula quando não deu pra ter.
  sessionId String?  @map("session_id") @db.VarChar(64)
  /// Valor em reais quando o evento carrega (checkout, add_to_cart).
  valor     Decimal? @db.Decimal(12, 2)
  /// O resto que der contexto sem dado pessoal: REFs, termo de busca, origem.
  dados     Json?
  /// true = visitante sem aceite do banner (linha anônima).
  semAceite Boolean  @default(false) @map("sem_aceite")
  /// true = NÃO é gente. Carimbado na origem pelo user-agent, no `/api/events`
  /// do site — que é o único ponto que enxerga o navegador de verdade (aqui
  /// chega tudo com o user-agent da Vercel). A linha continua sendo GRAVADA de
  /// propósito: marcada, responde "quem varreu meu site"; descartada, some.
  bot       Boolean  @default(false)
  /// Qual robô ('googlebot', 'gptbot', 'ahrefsbot', 'headless'…). Null = gente.
  botNome   String?  @map("bot_nome") @db.VarChar(60)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@index([evento, criadoEm])
  /// Toda tela de métrica filtra `bot = false` antes de qualquer outra coisa.
  @@index([bot, criadoEm])
  @@map("site_eventos")
}

/// GASTO DE ANÚNCIO POR CAMPANHA E DIA — o "I" do ROAS.
///
/// A receita já mora aqui (`Order.utmId`), o gasto não morava em lugar nenhum:
/// vive no Gerenciador do Meta. Este espelho traz o gasto pra dentro do
/// Postgres pra tela poder dividir um pelo outro sem depender de API na hora
/// de renderizar — mesmo princípio do espelho Wincred.
///
/// ⚠️ A CHAVE É O `campanhaId`, NUNCA O NOME. O nome muda quando alguém
/// renomeia a campanha no Meta, chega codificado duas vezes na URL e às vezes
/// vem como número. O id é imutável, e é o que o `utm_id={{campaign.id}}`
/// grava no pedido. O NOME vem daqui (da API), não do UTM — é o que conserta
/// de vez os rótulos tortos da cascata.
model MetaAdsGastoDia {
  id          String   @id @default(uuid())
  /// Conta de anúncio (sem o prefixo `act_`).
  contaId     String   @map("conta_id") @db.VarChar(32)
  /// `campaign.id` do Meta — casa com `Order.utmId`.
  campanhaId  String   @map("campanha_id") @db.VarChar(40)
  /// Nome no dia da coleta. Guardado pra tela mostrar rótulo mesmo quando a
  /// campanha some do Gerenciador; o id continua sendo quem manda.
  campanhaNome String? @map("campanha_nome") @db.VarChar(200)
  /// Dia no fuso de São Paulo (00:00 local), não UTC — a tela é De/Até local.
  dia         DateTime @db.Date
  gasto       Decimal  @default(0) @db.Decimal(12, 2)
  impressoes  Int      @default(0)
  cliques     Int      @default(0)
  /// Quantas chegadas na página o Meta contou — serve pra medir o quanto a
  /// nossa contagem de sessão diverge da dele.
  chegadas    Int      @default(0)
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  /// Recoleta do mesmo dia sobrescreve em vez de duplicar: o Meta reprocessa
  /// atribuição por dias, então o gasto de ontem ainda muda hoje.
  @@unique([contaId, campanhaId, dia])
  @@index([dia])
  @@map("meta_ads_gasto_dia")
}

/// LOOK — peças que formam um conjunto (dono, 13/08: Regata 403048 + Calça
/// Aladdin 406027 saem na MESMA foto e têm que se vender juntas). Fase 1: a
/// PDP de cada peça mostra as irmãs do look ("Complete o look"). Fase 2 (o
/// plano do dono): botão "Comprar o look" e o look como card próprio quando
/// houver mais fotos de conjunto. Curadoria HUMANA — nenhum robô cria look.
model SiteLook {
  id        String         @id @default(uuid())
  nome      String         @db.VarChar(80)
  criadoPor String?        @map("criado_por") @db.VarChar(80)
  criadoEm  DateTime       @default(now()) @map("criado_em")
  pecas     SiteLookPeca[]

  @@map("site_look")
}

model SiteLookPeca {
  id     String   @id @default(uuid())
  lookId String   @map("look_id")
  look   SiteLook @relation(fields: [lookId], references: [id], onDelete: Cascade)
  /// REF como está em `site_produto` — a vitrine resolve pela família
  /// (normRef/REF-BASE), então a irmã sufixada também encontra o look.
  ref    String   @db.VarChar(20)

  @@unique([lookId, ref])
  @@index([ref])
  @@map("site_look_peca")
}

/// O WHATSAPP DE QUEM CLICOU — enfim com nome e número (dono, 13/08: "onde
/// vejo o whats de quem clicou?"). O clique no site é anônimo por natureza;
/// a pessoa passa a existir quando ENVIA a mensagem carimbada ("vim pelo
/// site") no WhatsApp da loja. A Evolution recebe, o n8n reconhece o carimbo
/// e grava aqui via POST /public/site-metrics/whatsapp-lead. Tela:
/// /retaguarda/leads-whatsapp.
model WhatsappLead {
  id        String   @id @default(uuid())
  /// Só dígitos, como vem do remoteJid (com DDI: 5511...).
  telefone  String   @db.VarChar(20)
  /// pushName do WhatsApp — o nome que a pessoa usa no app.
  nome      String?  @db.VarChar(120)
  /// Unidade extraída do carimbo ("loja X (vim pelo site)"); nulo = botão geral.
  loja      String?  @db.VarChar(80)
  /// A mensagem como chegou — prova e contexto pra quem for responder.
  mensagem  String?  @db.Text
  /// Instância da Evolution que recebeu (o WhatsApp de qual loja atendeu).
  instancia String?  @db.VarChar(60)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@index([telefone, criadoEm])
  @@map("whatsapp_leads")
}

// ═══════════════════════════════════════════════════════════════════════
// DEFEITOS — peça avariada sai do estoque da loja e vai pra matriz (CD)
//
// Por que NÃO é marcado: marcado é dívida de cliente (entra no
// LIMITECOMPRAS, aparece em marcados ativos, exige avaliação do cliente).
// Defeito é perda de mercadoria e não tem cliente. Usar `Marcado
// status='baixado'` pra defeito sujava os dois controles.
//
// REGRA CENTRAL: a peça baixa do estoque UMA vez, no registro na loja, e
// nunca reentra — ela não volta pra vitrine (vai pro fornecedor ou pro
// lixo). Por isso a matriz, ao receber a caixa, NÃO movimenta estoque:
// só confirma a chegada. Isso é o que impede peça defeituosa de voltar a
// ser vendida.
// ═══════════════════════════════════════════════════════════════════════

// A caixa física que a loja monta e manda pra matriz. Uma caixa ABERTA por
// loja de cada vez — o registro de defeito cai nela automaticamente.
model DefectBatch {
  id              String    @id @default(uuid())
  // Código humano sequencial: CX-2026-000045
  code            String    @unique @db.VarChar(20)
  storeCodeOrigem String    @map("store_code_origem") @db.VarChar(10)
  storeNameOrigem String?   @map("store_name_origem") @db.VarChar(80)
  // aberta (recebendo peças) | enviada (fechada, a caminho) | recebida
  status          String    @default("aberta") @db.VarChar(10)
  // Congelados no fechamento — o relatório não recalcula caixa fechada.
  totalPecas      Int       @default(0) @map("total_pecas")
  totalCustoCents Int       @default(0) @map("total_custo_cents")
  fechadaAt       DateTime? @map("fechada_at")
  fechadaPorNome  String?   @map("fechada_por_nome") @db.VarChar(80)
  recebidaAt      DateTime? @map("recebida_at")
  recebidaPorNome String?   @map("recebida_por_nome") @db.VarChar(80)
  createdAt       DateTime  @default(now()) @map("created_at")

  itens           DefectItem[]

  @@index([status, storeCodeOrigem])
  @@map("defect_batches")
}

// Uma linha por PEÇA com defeito.
model DefectItem {
  id              String    @id @default(uuid())
  // Número de controle humano: DEF-2026-000123
  code            String    @unique @db.VarChar(20)

  // ── Peça (snapshot no registro; o cadastro pode mudar depois) ──
  sku             String    @db.VarChar(20)
  ref             String?   @db.VarChar(20)
  descricao       String?   @db.VarChar(150)
  cor             String?   @db.VarChar(30)
  tamanho         String?   @db.VarChar(20)

  // ── Fornecedor (snapshot) — é por ele que a devolução é agrupada ──
  fornecedorCnpj  String?   @map("fornecedor_cnpj") @db.VarChar(20)
  fornecedorNome  String?   @map("fornecedor_nome") @db.VarChar(80)
  marca           String?   @db.VarChar(40)

  // ── Valor (snapshot, em centavos) — base do valor da perda ──
  custoUnitCents  Int       @default(0) @map("custo_unit_cents")
  precoUnitCents  Int       @default(0) @map("preco_unit_cents")

  // ── Origem ──
  storeCodeOrigem String    @map("store_code_origem") @db.VarChar(10)
  storeNameOrigem String?   @map("store_name_origem") @db.VarChar(80)
  // LOJA | DEVOLUCAO_CLIENTE | MATRIZ | MIGRACAO_MARCADO
  origem          String    @default("LOJA") @db.VarChar(20)

  // ── Defeito ──
  // FURO_RASGO | MANCHA | COSTURA_SOLTA | ZIPER_BOTAO | DESBOTADO |
  // FALTA_PECA | MODELAGEM_ERRADA | OUTRO (exige observação)
  motivo          String    @db.VarChar(20)
  observacao      String?   @db.Text
  fotoUrl         String?   @map("foto_url") @db.Text

  // ── Ciclo de vida ──
  // EM_TRANSITO -> RECEBIDO -> DEVOLVIDO_FORNECEDOR | DESCARTADO
  status              String    @default("EM_TRANSITO") @db.VarChar(25)
  registradoPorUserId String?   @map("registrado_por_user_id")
  registradoPorNome   String?   @map("registrado_por_nome") @db.VarChar(80)
  registradoAt        DateTime  @default(now()) @map("registrado_at")
  recebidoPorNome     String?   @map("recebido_por_nome") @db.VarChar(80)
  recebidoAt          DateTime? @map("recebido_at")
  decididoPorNome     String?   @map("decidido_por_nome") @db.VarChar(80)
  decididoAt          DateTime? @map("decidido_at")
  decisaoObservacao   String?   @map("decisao_observacao") @db.Text

  // ── Vínculos ──
  batchId         String?      @map("batch_id")
  batch           DefectBatch? @relation(fields: [batchId], references: [id])
  // Devolução de cliente que originou o defeito (origem=DEVOLUCAO_CLIENTE).
  returnId        String?      @map("return_id")
  // Marcado 'baixado' que virou este registro. UNIQUE = idempotência da
  // migração: rodar duas vezes não duplica.
  marcadoId       String?      @unique @map("marcado_id")

  // ── Controle ──
  // Trava de idempotência da baixa, no padrão do ErpOutboxService. Na
  // MIGRAÇÃO vem preenchido com a data original: a peça já saiu do estoque
  // quando o marcado foi criado — rebaixar duplicaria a perda.
  stockDecreasedAt DateTime? @map("stock_decreased_at")
  isTraining       Boolean   @default(false) @map("is_training")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([status, storeCodeOrigem])
  @@index([fornecedorCnpj, status])
  @@index([batchId])
  @@index([registradoAt])
  @@map("defect_items")
}

// CAMPANHA DE WHATSAPP pelo FlowOps (dono, 15/08/2026). A operadora escolhe um
// publico, o sistema dispara pausado via Evolution, com kill-switch. Substitui
// o disparo orfao do n8n. So `//` nos comentarios: `/** */` quebra o schema.
model WhatsappCampaign {
  id              String    @id @default(uuid())
  nome            String
  segmento        String
  mensagens       String
  imagemUrl       String?   @map("imagem_url")
  status          String    @default("rascunho")
  intervaloMinSeg Int       @default(45) @map("intervalo_min_seg")
  intervaloMaxSeg Int       @default(120) @map("intervalo_max_seg")
  total           Int       @default(0)
  enviados        Int       @default(0)
  falhas          Int       @default(0)
  falhasSeguidas  Int       @default(0) @map("falhas_seguidas")
  ultimoEnvioEm   DateTime? @map("ultimo_envio_em")
  pausaMotivo     String?   @map("pausa_motivo")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @default(now()) @updatedAt @map("atualizado_em")
  recipients      WhatsappCampaignRecipient[]

  @@index([status])
  @@map("whatsapp_campaigns")
}

model WhatsappCampaignRecipient {
  id         String    @id @default(uuid())
  campaignId String    @map("campaign_id")
  nome       String
  fone       String
  mensagem   String
  status     String    @default("pendente")
  erro       String?
  tentativas Int       @default(0)
  enviadoEm  DateTime? @map("enviado_em")
  criadoEm   DateTime  @default(now()) @map("criado_em")
  campaign   WhatsappCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("whatsapp_campaign_recipients")
}

/// Rascunho privado do editor visual. Uma linha por recurso editável.
model SiteContentDraft {
  id           String   @id @default(uuid())
  resourceType String   @map("resource_type") @db.VarChar(24)
  resourceKey  String   @map("resource_key") @db.VarChar(180)
  payload      Json
  state        String   @default("draft") @db.VarChar(32)
  baseVersion  Int      @default(0) @map("base_version")
  editedBy     String?  @map("edited_by") @db.VarChar(160)
  errorMessage String?  @map("error_message") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([resourceType, resourceKey])
  @@index([state, updatedAt])
  @@map("site_content_drafts")
}

/// Fotografia imutável de cada publicação ou restauração.
model SiteContentVersion {
  id           String   @id @default(uuid())
  resourceType String   @map("resource_type") @db.VarChar(24)
  resourceKey  String   @map("resource_key") @db.VarChar(180)
  version      Int
  payload      Json
  origin       String   @default("publish") @db.VarChar(24)
  publishedBy  String?  @map("published_by") @db.VarChar(160)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([resourceType, resourceKey, version])
  @@index([resourceType, resourceKey, createdAt])
  @@map("site_content_versions")
}

// INBOX DE WHATSAPP alimentado por WEBHOOK do Evolution (dono, 15/08). O
// findChats devolvia 42k conversas (lento) e as vezes nem trazia a nova. Agora
// o Evolution EMPURRA cada mensagem; a gente indexa aqui e o inbox le do banco:
// instantaneo, tempo real e completo. So `//` nos comentarios (o /** quebra).
model WhatsappConversation {
  id           String    @id @default(uuid())
  jid          String    @unique
  numero       String
  nome         String?
  ultimaMsg    String?   @map("ultima_msg")
  ultimaEm     DateTime? @map("ultima_em")
  fromMe       Boolean   @default(false) @map("from_me")
  naoLidas     Int       @default(0) @map("nao_lidas")
  // Reivindicacao ATOMICA do direito de auto-responder (anti-duplicata entre
  // processos: no rolling deploy do Railway 2 processos rodam o cron ~30s).
  autoRepliedAt DateTime? @map("auto_replied_at")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em")
  mensagens    WhatsappMessage[]

  @@index([ultimaEm])
  @@map("whatsapp_conversations")
}

model WhatsappMessage {
  id              String   @id @default(uuid())
  conversationJid String   @map("conversation_jid")
  waId            String?  @unique @map("wa_id")
  fromMe          Boolean  @default(false) @map("from_me")
  texto           String?
  tipo            String?
  status          String?
  ts              DateTime
  criadoEm        DateTime @default(now()) @map("criado_em")
  conversation    WhatsappConversation @relation(fields: [conversationJid], references: [jid], onDelete: Cascade)

  @@index([conversationJid, ts])
  @@map("whatsapp_messages")
}
