// ════════════════════════════════════════════════════════════════════════
// PURCHASE ORDERS — pedidos de compra do fornecedor.
// Fluxo: Cria pedido (header + items REF×COR×TAMs com QTYs) → Status pending →
// Mercadoria chega → Confere/ajusta → Marca recebido → Sistema AUTO-CADASTRA
// SKUs no Wincred (gera EAN-13 prefixo 8) + atualiza estoque + fila de etiquetas.
// ════════════════════════════════════════════════════════════════════════

// Gestão financeira e cronograma de obras. Este domínio permanece privado no
// FlowOps e nunca integra o snapshot público destinado aos corretores.
model PropertyConstructionProject {
  id              String   @id @default(uuid())
  propertyId      String   @map("property_id")
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name            String
  description     String?  @db.Text
  status          String   @default("planejamento")
  plannedStartAt  DateTime? @map("planned_start_at")
  plannedEndAt    DateTime? @map("planned_end_at")
  actualStartAt   DateTime? @map("actual_start_at")
  actualEndAt     DateTime? @map("actual_end_at")
  createdByUserId String?  @map("created_by_user_id")
  createdByName   String?  @map("created_by_name")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  stages          ConstructionStage[]
  commitments     ConstructionCommitment[]
  payments        ConstructionPayment[]
  entries         ConstructionEntry[]
  documents       ConstructionDocument[]
  auditLogs       ConstructionAuditLog[]

  @@index([propertyId, status])
  @@index([propertyId, createdAt(sort: Desc)])
  @@map("property_construction_projects")
}

model ConstructionCategory {
