model ConstructionCommitment {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  project         PropertyConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId         String?  @map("stage_id")
  stage           ConstructionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  categoryId      String?  @map("category_id")
  category        ConstructionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendorId        String?  @map("vendor_id")
  vendor          ConstructionVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  description     String
  contractedAt    DateTime @map("contracted_at")
  amountCents     Int      @map("amount_cents")
  dueDate         DateTime? @map("due_date")
  notes           String?  @db.Text
  status          String   @default("ativa")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelledReason String?  @map("cancelled_reason") @db.Text
  createdByUserId String?  @map("created_by_user_id")
  createdByName   String?  @map("created_by_name")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  payments        ConstructionPayment[]
  documents       ConstructionDocument[]

  @@index([projectId, contractedAt(sort: Desc)])
  @@index([projectId, status, dueDate])
  @@index([vendorId])
