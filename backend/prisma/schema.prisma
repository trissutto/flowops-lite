}

model ConstructionStage {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  project         PropertyConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId      String?  @map("category_id")
  category        ConstructionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String
  description     String?  @db.Text
  responsible     String?
  plannedStartAt  DateTime? @map("planned_start_at")
  plannedEndAt    DateTime? @map("planned_end_at")
  actualStartAt   DateTime? @map("actual_start_at")
  actualEndAt     DateTime? @map("actual_end_at")
  budgetCents     Int      @default(0) @map("budget_cents")
  progressPercent Int      @default(0) @map("progress_percent")
  status          String   @default("nao_iniciada")
  sortOrder       Int      @default(0) @map("sort_order")
  createdByUserId String?  @map("created_by_user_id")
  createdByName   String?  @map("created_by_name")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  commitments     ConstructionCommitment[]
  payments        ConstructionPayment[]

  @@index([projectId, sortOrder])
  @@index([projectId, status])
  @@map("construction_stages")
